<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        资产列表项样式（LF-004）。

        与插件/报告/开发者工具列表共用同一套"浅强调底 + 左侧指示线"视觉语言：
        选中态在多个页面里必须长得一样，否则用户会以为是三种不同的交互。

        分组头行与资产行在同一个 ListBox 里：
          - 分组头行不可选中（IsGroupHeader），因此"选中项一定是一台真实资产"是结构保证；
          - 分组头行用更弱的前景色与更矮的高度，与资产行明显区分。
    -->

    <Style x:Key="LfAssetListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LfBrushTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="SelectionIndicator"
                                Grid.Column="0"
                                Width="{DynamicResource LfListSelectionIndicatorWidth}"
                                Background="{DynamicResource LfBrushAccent}"
                                Visibility="Collapsed" />

                        <Border x:Name="ItemBackground"
                                Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource LfRadiusControl}"
                                Padding="{DynamicResource LfListItemPadding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{DynamicResource LfBrushSurfaceSubtle}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{DynamicResource LfBrushAccentSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ItemBackground"
                                    Property="BorderBrush"
                                    Value="{DynamicResource LfBrushAccent}" />
                            <Setter TargetName="ItemBackground"
                                    Property="BorderThickness"
                                    Value="{DynamicResource LfBorderThickness}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--
            分组头行不可选中（IsGroupHeader 为 true 时禁用容器）。

            刻意用 DataTrigger 而不是给分组头单独一种容器样式：
            ItemContainerStyle 只能给整个 ListBox 指定一种样式，
            而"按行的类型切换样式"需要 ItemContainerStyleSelector 或
            在 DataTemplate 里改容器 —— 后者会让分组头与资产行
            各自维护一份模板，视觉语言容易漂移。

            IsEnabled=False 作用于容器本身，因此子内容不会被单独置灰；
            组内真正的视觉区分由模板里的前景色与高度承担。
            Opacity 显式回到 1：模板里有"禁用即半透明"的触发器，
            而分组头不是"不可用"，只是"不可选中"。
        -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
