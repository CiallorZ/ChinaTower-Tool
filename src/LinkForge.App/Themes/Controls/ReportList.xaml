<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        报告来源列表项样式（LF-010）。

        为什么不能沿用 WPF-UI 默认 ListBoxItem：
        默认选中态使用系统强调色（深蓝）并强制把前景改为白色，
        而条目内部有多级文字（主标题、目标、时间、统计），
        只有模板级 Foreground 被改，子元素自己的令牌色不受影响 ——
        实际渲染就是"深蓝底 + 深灰字"，几乎不可读（截图验证时真实发现）。

        这里用"浅强调底 + 左侧指示线 + 文字保持主色"表达选中，
        与导航项保持同一套视觉语言，且浅/深色主题都能通过令牌自动适配。
    -->

    <Style x:Key="LfReportRunListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LfBrushTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 选中指示线：与导航项一致，保证"选中"不依赖颜色单通道表达。 -->
                        <Border x:Name="SelectionIndicator"
                                Grid.Column="0"
                                Width="{DynamicResource LfListSelectionIndicatorWidth}"
                                Background="{DynamicResource LfBrushAccent}"
                                Visibility="Collapsed" />

                        <Border x:Name="ItemBackground"
                                Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource LfRadiusControl}"
                                Padding="{DynamicResource LfListItemPadding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{DynamicResource LfBrushSurfaceSubtle}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{DynamicResource LfBrushAccentSubtle}" />
                        </Trigger>

                        <!--
                            选中且悬停时保持强调底，不再切回 SurfaceSubtle：
                            否则鼠标划过选中项会"看起来取消选中"。
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{DynamicResource LfBrushAccentSubtle}" />
                        </MultiTrigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ItemBackground"
                                    Property="BorderBrush"
                                    Value="{DynamicResource LfBrushAccent}" />
                            <Setter TargetName="ItemBackground"
                                    Property="BorderThickness"
                                    Value="{DynamicResource LfBorderThickness}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
