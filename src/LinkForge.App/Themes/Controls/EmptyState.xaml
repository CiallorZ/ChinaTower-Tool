<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LinkForge.App.Controls">

    <!--
        转换器定义在本字典内，而不是放到共享位置再引用：
        控件模板实例化时才解析 StaticResource，跨字典依赖会让
        "哪个字典必须先合并"成为隐式契约；本字典自包含则不依赖合并顺序。
    -->
    <BooleanToVisibilityConverter x:Key="LfBoolToVisibility" />

    <!--
        EmptyState 默认样式（UI 规范 §5.6 初始空状态）。

        三条硬性约束：
          1. 不使用危险色——空状态不是错误状态。
          2. 必须说明"这里是什么、如何开始"，因此 Description 为空时也要有意义（由调用方保证）。
          3. 未提供主操作时隐藏操作区，而不是显示一个点了没反应的按钮（由 HasAction 控制）。
    -->

    <Style TargetType="{x:Type controls:EmptyState}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EmptyState}">
                    <Border Background="{DynamicResource LfBrushSurface}"
                            BorderBrush="{DynamicResource LfBrushBorder}"
                            BorderThickness="{DynamicResource LfBorderThickness}"
                            CornerRadius="{DynamicResource LfRadiusPanel}"
                            Padding="{DynamicResource LfPagePadding}"
                            SnapsToDevicePixels="True">
                        <StackPanel>

                            <!-- 图标：空状态用"容器/占位"语义，不用警告或错误图标。 -->
                            <TextBlock Text="&#xE8FD;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{DynamicResource LfIconSizeLg}"
                                       Foreground="{DynamicResource LfBrushTextMuted}"
                                       HorizontalAlignment="Center"
                                       Margin="{DynamicResource LfInlineSpacing}" />

                            <TextBlock Text="{TemplateBinding Title}"
                                       FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LfBrushTextPrimary}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />

                            <TextBlock Text="{TemplateBinding Description}"
                                       Margin="{DynamicResource LfBlockSpacing}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />

                            <!-- 无主操作时整体折叠，避免留下一个不可点的按钮。 -->
                            <Button Content="{TemplateBinding ActionText}"
                                    Command="{TemplateBinding ActionCommand}"
                                    CommandParameter="{TemplateBinding ActionCommandParameter}"
                                    Margin="{DynamicResource LfSectionSpacing}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasAction,
                                                         RelativeSource={RelativeSource TemplatedParent},
                                                         Converter={StaticResource LfBoolToVisibility}}" />

                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
