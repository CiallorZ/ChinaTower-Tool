<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LinkForge.App.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        SecretTextBox 默认样式（UI 规范 §5.2、§9）。

        三条安全约束在模板层面体现：
          1. 默认遮蔽：由 WPF-UI PasswordBox 自带的显示按钮控制（默认关闭），
             沿用控件库行为而不是自建开关（ADR-018：优先保留控件库模板）。
          2. 默认禁止复制：CanCopy 默认 False，控件层已阻断 Ctrl+C 与复制命令。
          3. 界面给出可见提示：明文曝光与复制开启都是高风险动作，
             用 ToolTip 提前说明后果，而不是等用户做完才告知。

        明文显示与复制刻意分开：
        "看得见"与"可以带走"是两种不同的泄露途径，不应被同一个按钮同时打开。
        明文当前可见时会显示明确的警告条，让用户在屏幕共享/录屏前就知道风险。
    -->

    <BooleanToVisibilityConverter x:Key="LfBoolToVisibility" />

    <Style TargetType="{x:Type controls:SecretTextBox}">
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SecretTextBox}">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Label}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       FontSize="{DynamicResource LfFontSizeCaption}" />

                            <!-- 已录入时用文字确认，不显示内容，也不按长度显示圆点。 -->
                            <TextBlock Text="已填写"
                                       Foreground="{DynamicResource LfBrushSuccess}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Margin="{DynamicResource LfInlineSpacingXxs}"
                                       Visibility="{Binding HasSecret,
                                                            RelativeSource={RelativeSource TemplatedParent},
                                                            Converter={StaticResource LfBoolToVisibility}}" />
                        </StackPanel>

                        <ui:PasswordBox x:Name="PART_PasswordBox"
                                        PlaceholderText="{TemplateBinding Placeholder}"
                                        RevealButtonEnabled="True"
                                        Margin="{DynamicResource LfInlineSpacing}"
                                        Height="{DynamicResource LfControlHeight}" />

                        <!--
                            明文当前可见时的警告条。
                            IsPasswordRevealed 是只读依赖属性（由控件库的显示按钮驱动），
                            这里只能读取、不能反向设置——正因如此才复用控件库的开关，
                            而不是试图自建一个与之竞争的开关。
                        -->
                        <Border Background="{DynamicResource LfBrushWarningSubtle}"
                                BorderBrush="{DynamicResource LfBrushWarning}"
                                BorderThickness="{DynamicResource LfBorderThickness}"
                                CornerRadius="{DynamicResource LfRadiusControl}"
                                Padding="{DynamicResource LfControlPadding}"
                                Margin="{DynamicResource LfInlineSpacing}"
                                Visibility="{Binding IsRevealed,
                                                     RelativeSource={RelativeSource TemplatedParent},
                                                     Converter={StaticResource LfBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="{DynamicResource LfIconSizeSm}"
                                           Foreground="{DynamicResource LfBrushWarning}"
                                           VerticalAlignment="Center"
                                           Margin="{DynamicResource LfLabelSpacing}" />
                                <TextBlock Text="口令当前以明文显示，请注意屏幕共享与录屏风险。"
                                           FontSize="{DynamicResource LfFontSizeCaption}"
                                           Foreground="{DynamicResource LfBrushTextPrimary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!--
                            LinkForge 自行增加的两个安全开关（控件库不提供）：
                            允许复制：默认关，开启后口令才能进入剪贴板。
                            清空：立即丢弃明文，并同时关闭复制许可。
                        -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="{DynamicResource LfInlineSpacing}">

                            <ToggleButton Content="允许复制"
                                          IsChecked="{Binding CanCopy,
                                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Height="{DynamicResource LfControlHeightCompact}"
                                          ToolTip="开启后 Ctrl+C 会把明文口令放入剪贴板，可能被粘贴到日志或聊天中。默认关闭。" />

                            <!--
                                用命令而非 Click 事件：资源字典不能有代码后置，
                                而"清空"是控件自身职责，也不该让每个页面都去实现一遍。
                            -->
                            <Button Content="清空"
                                    Command="{x:Static controls:SecretTextBox.ClearCommand}"
                                    Height="{DynamicResource LfControlHeightCompact}"
                                    Margin="{DynamicResource LfInlineSpacingLeading}"
                                    ToolTip="清除已录入的口令，并同时关闭复制许可。" />

                        </StackPanel>

                        <TextBlock Text="{TemplateBinding ErrorText}"
                                   Foreground="{DynamicResource LfBrushDanger}"
                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                   Margin="{DynamicResource LfInlineSpacing}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasError,
                                                        RelativeSource={RelativeSource TemplatedParent},
                                                        Converter={StaticResource LfBoolToVisibility}}" />

                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
