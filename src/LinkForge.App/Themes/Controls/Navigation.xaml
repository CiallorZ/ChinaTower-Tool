<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nav="clr-namespace:LinkForge.App.Navigation">

    <!--
        导航项样式（UI 规范 §3.2）。

        选中态必须同时体现三件事，不得只改图标颜色：
          1. 背景色变化
          2. 左侧指示线
          3. 文字字重加粗

        折叠模式下仍保留 ToolTip 与 AutomationProperties.Name，
        因此这里不改变这些属性，只由 ShellWindow 的模板负责隐藏文字。
    -->

    <BooleanToVisibilityConverter x:Key="LfBoolToVisibility" />

    <Style x:Key="LfNavigationTreeItemStyle" TargetType="{x:Type TreeViewItem}">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource LfNavItemPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource LfNavItemHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource LfBrushTextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <!--
                            指示线 + 内容：
                            用 Grid 而非 Border.Child 叠加，让指示线能独立于内容宽度。
                        -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧选中指示线（规范 §3.2 明确要求） -->
                            <Border x:Name="SelectionIndicator"
                                    Grid.Column="0"
                                    Width="{DynamicResource LfNavSelectionIndicatorWidth}"
                                    Background="{DynamicResource LfBrushAccent}"
                                    Visibility="Collapsed" />

                            <Border x:Name="ItemBackground"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource LfRadiusControl}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch" />

                                    <!-- 展开箭头：仅有子项时显示 -->
                                    <ToggleButton Grid.Column="1"
                                                  x:Name="Expander"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded,
                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                      Mode=TwoWay}">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <TextBlock Text="&#xE70D;"
                                                                       FontFamily="{DynamicResource LfIconFontFamily}"
                                                                       FontSize="{DynamicResource LfIconSizeSm}"
                                                                       Foreground="{DynamicResource LfBrushTextSecondary}" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                        </Grid>

                        <ItemsPresenter x:Name="ItemsHost" Margin="{DynamicResource LfLabelSpacing}" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- 有子项时才显示展开箭头 -->
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!-- 选中态：背景 + 指示线 + 字重（三要素同时生效） -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ItemBackground" Property="Background"
                                    Value="{DynamicResource LfBrushAccentSubtle}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>

                        <!-- 悬停态：仅在未选中时生效，避免与选中态视觉冲突 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBackground" Property="Background"
                                    Value="{DynamicResource LfBrushSurfaceSubtle}" />
                        </MultiTrigger>

                        <!-- 键盘焦点可见（规范 §12 要求焦点可见） -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ItemBackground" Property="BorderBrush"
                                    Value="{DynamicResource LfBrushFocus}" />
                            <Setter TargetName="ItemBackground" Property="BorderThickness"
                                    Value="{DynamicResource LfFocusThickness}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>