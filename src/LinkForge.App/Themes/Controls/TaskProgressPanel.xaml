<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LinkForge.App.Controls">

    <!--
        TaskProgressPanel 默认样式（UI 规范 §5.6 运行状态、§6 长任务）。

        规范原文："运行状态：显示阶段、耗时、停止入口。"

        三个必须同时可见的信息：
          1. 阶段（Stage）：让用户知道"卡在哪一步"，而不是只看到转圈
          2. 耗时（ElapsedText）：让用户可以判断"是不是异常慢"
          3. 取消入口：长任务必须可取消（§6、用户硬约束）

        进度条只在执行期显示（IsIndeterminate 由控件按状态推导）：
        终态后继续显示进度条会误导用户以为仍在运行。

        不可取消时按钮置灰而非隐藏：隐藏会让用户以为工具没有取消能力。
    -->

    <BooleanToVisibilityConverter x:Key="LfBoolToVisibility" />

    <Style TargetType="{x:Type controls:TaskProgressPanel}">
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TaskProgressPanel}">
                    <Border Background="{DynamicResource LfBrushRunningSubtle}"
                            BorderBrush="{DynamicResource LfBrushRunning}"
                            BorderThickness="{DynamicResource LfBorderThickness}"
                            CornerRadius="{DynamicResource LfRadiusPanel}"
                            Padding="{DynamicResource LfCardPadding}"
                            SnapsToDevicePixels="True">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="&#xE895;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{DynamicResource LfIconSizeMd}"
                                       Foreground="{DynamicResource LfBrushRunning}"
                                       VerticalAlignment="Center"
                                       Margin="{DynamicResource LfLabelSpacing}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                <TextBlock Text="{TemplateBinding Stage}"
                                           Foreground="{DynamicResource LfBrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- 仅执行期显示；终态后隐藏，避免误导。 -->
                                <ProgressBar Margin="{DynamicResource LfInlineSpacing}"
                                             Height="4"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsActive,
                                                                   RelativeSource={RelativeSource TemplatedParent},
                                                                   Converter={StaticResource LfBoolToVisibility}}"
                                             Foreground="{DynamicResource LfBrushRunning}"
                                             Background="{DynamicResource LfBrushSurfaceSubtle}" />

                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="&#xE823;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{DynamicResource LfIconSizeSm}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="{DynamicResource LfLabelSpacing}" />

                            <TextBlock Grid.Column="3"
                                       Text="{TemplateBinding ElapsedText}"
                                       FontFamily="{DynamicResource LfFontFamilyMono}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       VerticalAlignment="Center" />

                            <!--
                                取消入口：长任务的必备出口。
                                IsEnabled 绑定 CanCancel 与命令可用性，
                                置灰而非隐藏，并给出为什么不可取消的解释。
                            -->
                            <Button Grid.Column="4"
                                    Content="停止"
                                    Command="{TemplateBinding CancelCommand}"
                                    IsEnabled="{TemplateBinding CanCancel}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    Margin="{DynamicResource LfInlineSpacingLeading}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="停止当前任务" />

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
