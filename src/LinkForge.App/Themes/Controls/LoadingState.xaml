<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LinkForge.App.Controls">

    <!--
        LoadingState 默认样式（UI 规范 §5.6 加载/准备状态、§6 动效）。

        规范禁止"无限旋转且没有文字"，因此模板**始终**显示 Message：
        它描述"正在做什么"，用户可以据此判断是否需要等待或取消。
        Message 有非空默认值，调用方留空也会显示保底文案。

        不确定进度条表示"无法预估完成比例"，比空转图标更诚实：
        若给人"已完成 60%"的错觉而实际无法估算，是误导。
    -->

    <Style TargetType="{x:Type controls:LoadingState}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LoadingState}">
                    <Border Background="{DynamicResource LfBrushSurface}"
                            BorderBrush="{DynamicResource LfBrushBorder}"
                            BorderThickness="{DynamicResource LfBorderThickness}"
                            CornerRadius="{DynamicResource LfRadiusPanel}"
                            Padding="{DynamicResource LfPagePadding}"
                            SnapsToDevicePixels="True">
                        <StackPanel>

                            <ProgressBar IsIndeterminate="True"
                                         Height="4"
                                         Margin="{DynamicResource LfInlineSpacing}"
                                         Foreground="{DynamicResource LfBrushRunning}"
                                         Background="{DynamicResource LfBrushSurfaceSubtle}" />

                            <TextBlock Text="{TemplateBinding Message}"
                                       Margin="{DynamicResource LfBlockSpacing}"
                                       Foreground="{DynamicResource LfBrushTextPrimary}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />

                            <TextBlock Text="{TemplateBinding Detail}"
                                       Margin="{DynamicResource LfInlineSpacing}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />

                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
