<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        LinkForge 设计令牌 · 维度（与主题无关）

        依据：docs/LinkForge_UI_Design_Guidelines_V1.1.md §2.2、docs/DECISIONS.md ADR-015
        颜色令牌见 Themes/Tokens/Palette.Light.xaml 与 Palette.Dark.xaml（运行时可替换）。

        约束：业务页面禁止硬编码间距、字号、圆角、控件高度，一律引用本文件的 Lf* 令牌。
    -->

    <!-- ===================== 字体族 ===================== -->
    <!-- Windows 10/11 均自带；中文优先雅黑 UI，西文回退 Segoe UI。 -->
    <FontFamily x:Key="LfFontFamilyUi">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="LfFontFamilyMono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!--
        图标字体：Segoe Fluent Icons 优先，Windows 10 回退 Segoe MDL2 Assets。
        两者在本项目使用的全部码位上已实测一致（见 Navigation/LfGlyph.cs 的说明）。
    -->
    <FontFamily x:Key="LfIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===================== 字号 ===================== -->
    <!-- 规范 §2.2：辅助 12-13 / 主文本 13-14 / 区块标题 15-18 / 页面标题 22-28 -->
    <sys:Double x:Key="LfFontSizeCaption">12</sys:Double>
    <sys:Double x:Key="LfFontSizeBody">13</sys:Double>
    <sys:Double x:Key="LfFontSizeBodyLarge">14</sys:Double>
    <sys:Double x:Key="LfFontSizeSectionTitle">16</sys:Double>
    <sys:Double x:Key="LfFontSizePageTitle">24</sys:Double>
    <sys:Double x:Key="LfFontSizeDisplay">28</sys:Double>

    <sys:Double x:Key="LfLineHeightCaption">16</sys:Double>
    <sys:Double x:Key="LfLineHeightBody">20</sys:Double>
    <sys:Double x:Key="LfLineHeightBodyLarge">22</sys:Double>
    <sys:Double x:Key="LfLineHeightSectionTitle">24</sys:Double>
    <sys:Double x:Key="LfLineHeightPageTitle">32</sys:Double>

    <!-- ===================== 间距（4px 基础单位） ===================== -->
    <sys:Double x:Key="LfSpacingUnit">4</sys:Double>
    <sys:Double x:Key="LfSpacingXxs">2</sys:Double>
    <sys:Double x:Key="LfSpacingXs">4</sys:Double>
    <sys:Double x:Key="LfSpacingSm">8</sys:Double>
    <sys:Double x:Key="LfSpacingMd">12</sys:Double>
    <sys:Double x:Key="LfSpacingLg">16</sys:Double>
    <sys:Double x:Key="LfSpacingXl">20</sys:Double>
    <sys:Double x:Key="LfSpacing2Xl">24</sys:Double>
    <sys:Double x:Key="LfSpacing3Xl">32</sys:Double>

    <!-- 页面内边距：常规 24，密集表格页 16-20，弹窗内容 20-24 -->
    <Thickness x:Key="LfPagePadding">24</Thickness>
    <Thickness x:Key="LfPagePaddingCompact">16</Thickness>
    <Thickness x:Key="LfDialogPadding">20</Thickness>
    <Thickness x:Key="LfCardPadding">16</Thickness>
    <Thickness x:Key="LfControlPadding">10,0</Thickness>
    <Thickness x:Key="LfControlPaddingCompact">8,0</Thickness>

    <!--
        组合边距：WPF 不允许在 {StaticResource} 后追加字面量（如 "{StaticResource LfPagePadding},0"），
        因此所有"部分方向"的边距都必须以完整 Thickness 令牌形式定义。
    -->
    <Thickness x:Key="LfHeaderPadding">24,0</Thickness>
    <Thickness x:Key="LfStatusBarPadding">24,0</Thickness>
    <Thickness x:Key="LfPageHeaderSpacing">0,0,0,16</Thickness>
    <Thickness x:Key="LfSectionSpacing">0,24,0,0</Thickness>
    <Thickness x:Key="LfBlockSpacing">0,12,0,0</Thickness>
    <Thickness x:Key="LfInlineSpacing">0,4,0,0</Thickness>
    <Thickness x:Key="LfInlineSpacingLeading">0,0,12,0</Thickness>
    <!-- 标签与必填标记之间的极窄间隙；WPF 不允许在 {StaticResource} 后追加字面量。 -->
    <Thickness x:Key="LfInlineSpacingXxs">2,0,0,0</Thickness>
    <Thickness x:Key="LfInlineSpacingSm">0,8,0,0</Thickness>
    <Thickness x:Key="LfBadgePadding">10,4</Thickness>
    <Thickness x:Key="LfBadgeSpacing">0,0,8,8</Thickness>
    <Thickness x:Key="LfLabelSpacing">0,0,8,0</Thickness>
    <Thickness x:Key="LfDividerTop">0,1,0,0</Thickness>
    <Thickness x:Key="LfDividerBottom">0,0,0,1</Thickness>
    <Thickness x:Key="LfDividerRight">0,0,1,0</Thickness>

    <!-- ===================== 圆角 ===================== -->
    <CornerRadius x:Key="LfRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="LfRadiusPanel">10</CornerRadius>
    <CornerRadius x:Key="LfRadiusDialog">12</CornerRadius>
    <CornerRadius x:Key="LfRadiusPill">999</CornerRadius>

    <!-- ===================== 控件尺寸 ===================== -->
    <!-- 最小可点击目标 32x32，高频操作优先 36 -->
    <sys:Double x:Key="LfControlHeight">34</sys:Double>
    <sys:Double x:Key="LfControlHeightCompact">30</sys:Double>
    <sys:Double x:Key="LfControlHeightLarge">38</sys:Double>
    <sys:Double x:Key="LfMinClickTarget">32</sys:Double>
    <sys:Double x:Key="LfButtonMinWidth">88</sys:Double>

    <!-- ===================== 图标 ===================== -->
    <sys:Double x:Key="LfIconSizeSm">16</sys:Double>
    <sys:Double x:Key="LfIconSizeMd">20</sys:Double>
    <sys:Double x:Key="LfIconSizeLg">24</sys:Double>
    <sys:Double x:Key="LfIconStrokeThickness">1.5</sys:Double>

    <!-- ===================== 应用壳层 ===================== -->
    <!-- 规范 §3.1：左侧导航 232-248，顶部标题区 48-56 -->
    <sys:Double x:Key="LfNavWidth">240</sys:Double>
    <sys:Double x:Key="LfNavWidthCompact">48</sys:Double>
    <sys:Double x:Key="LfHeaderHeight">52</sys:Double>
    <sys:Double x:Key="LfStatusBarHeight">26</sys:Double>
    <sys:Double x:Key="LfWindowMinWidth">1024</sys:Double>
    <sys:Double x:Key="LfWindowMinHeight">640</sys:Double>
    <sys:Double x:Key="LfReferenceWidth">1366</sys:Double>
    <sys:Double x:Key="LfReferenceHeight">768</sys:Double>

    <!--
        "标签 : 值"两列布局中标签列的固定宽度。
        工作台的运行环境、依赖状态、结果摘要都用它对齐，避免各页各写一个 120。
        固定而非 Auto：值列需要左边界对齐，Auto 会让每一行的值起始位置随标签长度浮动。
    -->
    <GridLength x:Key="LfLabelColumnWidth">120</GridLength>

    <!-- ===================== 壳层补充（阶段 03） ===================== -->
    <!-- 导航项高度：规范 §3.1 要求可点击目标不小于 32，导航项取 36 更易命中。 -->
    <sys:Double x:Key="LfNavItemHeight">36</sys:Double>
    <sys:Double x:Key="LfNavItemIconSize">16</sys:Double>
    <Thickness x:Key="LfNavItemPadding">12,0</Thickness>
    <!-- 页面标题区：标题 + 用途说明，规范 §4.2 第 1 项。 -->
    <Thickness x:Key="LfPageTitlePadding">24,20,24,12</Thickness>
    <Thickness x:Key="LfContentPadding">24,0,24,24</Thickness>
    <!-- 日志面板最小高度，与 AppSettingsStore.MinLogPanelHeight 保持一致。 -->
    <sys:Double x:Key="LfLogPanelMinHeight">96</sys:Double>
    <sys:Double x:Key="LfLogPanelDefaultHeight">200</sys:Double>
    <sys:Double x:Key="LfSplitterThickness">4</sys:Double>

    <!-- ===================== 工作台补充（阶段 04） ===================== -->
    <!--
        工作台是滚动页，行内元素需要"上下都有留白"的通用间距，
        既有的 LfInlineSpacing 只有上边距，不能用于步骤行之间的分隔。
    -->
    <Thickness x:Key="LfRowSpacing">0,8</Thickness>
    <!-- 步骤明细与历史列表的最大高度：超出后内部滚动，避免把整页撑得过长。 -->
    <sys:Double x:Key="LfStepListMaxHeight">260</sys:Double>
    <sys:Double x:Key="LfHistoryListMaxHeight">220</sys:Double>
    <!-- 快捷动作按钮：规范 §5.1 要求明确的动词文案，按钮需容纳较长文案。 -->
    <sys:Double x:Key="LfActionButtonMinWidth">140</sys:Double>
    <!-- 结论区与日志区之间的分隔线（放在块上方）。 -->
    <Thickness x:Key="LfDividerBlockTop">0,16,0,0</Thickness>

    <!-- ===================== 业务页面补充（阶段 05） ===================== -->
    <!-- 表单两列布局的列间距；固定 GridLength，避免页面各写一个 16/24。 -->
    <GridLength x:Key="LfFormColumnGap">16</GridLength>
    <!-- 列宽需要 GridLength；double 令牌不能直接赋给 ColumnDefinition.Width。 -->
    <GridLength x:Key="LfHeaderNameColumnWidth">120</GridLength>
    <!-- 网络结果事实表的标签列；比工作台的 120 略宽以容纳“第 12 跳”等中文标签。 -->
    <GridLength x:Key="LfFactLabelColumnWidth">140</GridLength>
    <!-- 网络结果列表上限；日志/跳点很多时内部滚动，不把主操作挤出屏幕。 -->
    <sys:Double x:Key="LfBusinessResultMaxHeight">280</sys:Double>
    <!-- 原始输出上限；大输出不撑高页面。 -->
    <sys:Double x:Key="LfRawOutputMaxHeight">220</sys:Double>
    <!-- 授权确认提示区与字段区的间距。 -->
    <Thickness x:Key="LfAuthorizationSpacing">0,16,0,0</Thickness>
    <!-- 网络工具选项说明与标题之间的间距。 -->
    <Thickness x:Key="LfOptionHintSpacing">0,2,0,0</Thickness>

    <!-- ===================== API 工作台补充（阶段 05） ===================== -->
    <sys:Double x:Key="LfMethodColumnWidth">104</sys:Double>
    <sys:Double x:Key="LfBodyEditorHeight">160</sys:Double>
    <sys:Double x:Key="LfResponseBodyHeight">280</sys:Double>

    <!-- ===================== MQTT 工作台补充（阶段 05） ===================== -->
    <!-- 消息流高度：内部滚动，避免长连接把主操作挤出可视区。 -->
    <sys:Double x:Key="LfMqttMessageListHeight">320</sys:Double>
    <!-- 空闲时（无消息）占位高度，保持消息卡片不会因空列表而塌缩成一条。 -->
    <sys:Double x:Key="LfMqttMessageEmptyHeight">200</sys:Double>
    <!-- 订阅列表与发布载荷编辑器高度。 -->
    <sys:Double x:Key="LfMqttSubscriptionListHeight">120</sys:Double>
    <sys:Double x:Key="LfMqttPayloadEditorHeight">110</sys:Double>
    <!-- 单条消息载荷的可视高度：超高载荷在条目内滚动，避免一条消息占满整页。 -->
    <sys:Double x:Key="LfMqttMessagePayloadHeight">64</sys:Double>

    <!-- ===================== 报告页（阶段 05 · LF-010） ===================== -->
    <!-- 任务历史选择列表高度：内部滚动，避免 50 条历史把操作区挤出首屏。 -->
    <sys:Double x:Key="LfReportRunListHeight">180</sys:Double>
    <!--
        列表选中指示线宽度。
        与导航指示线分开定义：导航栏是竖向紧凑列表，报告列表是横向信息条目，
        两者密度不同，后续调整其一时不应连带改变另一处。
    -->
    <sys:Double x:Key="LfListSelectionIndicatorWidth">3</sys:Double>
    <!-- 列表条目内边距：条目本身是整块可点区域，需要自己的呼吸空间。 -->
    <Thickness x:Key="LfListItemPadding">10,8</Thickness>
    <!--
        主布局列距。与 LfFormColumnGap 分开定义而不是复用：
        表单内字段间距与“控制区/消息区”这两栏的间距语义不同，
        后续调整表单密度时不应连带改变页面主分栏。
    -->
    <GridLength x:Key="LfMqttWorkspaceGap">16</GridLength>
    <!-- 1366 宽窗口下左栏占比；右栏留给消息流。 -->
    <GridLength x:Key="LfMqttControlColumnWidth">2*</GridLength>
    <GridLength x:Key="LfMqttStreamColumnWidth">3*</GridLength>

    <!-- ===================== 开发者工具页（阶段 05 · LF-011） ===================== -->
    <GridLength x:Key="LfDeveloperToolColumnWidth">180</GridLength>
    <!--
        工具列表上限高度。刻意用 MaxHeight 而不是 Height：
        固定 260 会裁掉第 8 项之后的条目，被裁的行与下方说明文字重叠。
        上限取 400 以容纳当前 10 项，超出后仍会内部滚动。
    -->
    <sys:Double x:Key="LfDeveloperToolListMaxHeight">400</sys:Double>
    <sys:Double x:Key="LfDeveloperEditorHeight">220</sys:Double>

    <!-- ===================== 插件管理页（阶段 05 · LF-012） ===================== -->
    <!--
        插件列表列宽与上限高度。列表用 MaxHeight 而不是 Height：
        插件数量由用户放入目录的条目决定，固定高度会在插件多于阈值时裁掉条目、
        少于阈值时留下大片空白（LF-011 的工具列表就是这么修掉的）。
    -->
    <GridLength x:Key="LfPluginListColumnWidth">340</GridLength>
    <sys:Double x:Key="LfPluginListMaxHeight">420</sys:Double>
    <!-- 行的最小高度：低于此高度时插件名与状态标签会挤在一起；高于此高度时随内容增长。 -->
    <sys:Double x:Key="LfPluginRowMinHeight">58</sys:Double>

    <!-- ===================== 描边 ===================== -->
    <Thickness x:Key="LfBorderThickness">1</Thickness>
    <!--
        无描边：用于父级已经提供描边或分隔线的子控件（TreeView、ListBox 等）。
        之所以不写字面量 0：静态守卫会把它当作硬编码视觉值，
        且"零描边"本身也可能随主题或密度调整，仍应集中管理。
    -->
    <Thickness x:Key="LfBorderThicknessNone">0</Thickness>
    <Thickness x:Key="LfFocusThickness">2</Thickness>
    <sys:Double x:Key="LfNavSelectionIndicatorWidth">3</sys:Double>

    <!--
        栅格间距：GridLength 与 double 是不同类型，
        不能用 LfSpacing3Xl 直接充当 ColumnDefinition.Width（会报"32 不是有效值"）。
        因此单独定义 GridLength 令牌。
    -->
    <sys:Double x:Key="LfGridGap">24</sys:Double>
    <GridLength x:Key="LfGridGapLength">24</GridLength>
    <GridLength x:Key="LfGridGapLengthCompact">16</GridLength>

    <!-- ===================== 动效 ===================== -->
    <!-- 规范 §6：动画轻量且可中断；持续动效仅用于"运行中"语义 -->
    <sys:TimeSpan x:Key="LfDurationFast">0:0:0.10</sys:TimeSpan>
    <sys:TimeSpan x:Key="LfDurationNormal">0:0:0.18</sys:TimeSpan>
    <sys:TimeSpan x:Key="LfDurationSlow">0:0:0.30</sys:TimeSpan>

</ResourceDictionary>
