<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LinkForge 设计令牌 · 深色主题（对等主题，非机械反色）

        依据：docs/LinkForge_UI_Design_Guidelines_V1.1.md §2.1 / §2.2、ADR-014
        深色值独立选取并单独校核对比度，不复用浅色值取反。
        令牌键集合必须与 Palette.Light.xaml 完全一致（由 DesignTokenTests 强制校验）。
    -->

    <!-- ===================== 表面 ===================== -->
    <Color x:Key="LfColorBackground">#FF16181D</Color>
    <Color x:Key="LfColorSurface">#FF1E2127</Color>
    <Color x:Key="LfColorSurfaceSubtle">#FF262A32</Color>
    <Color x:Key="LfColorSurfaceRaised">#FF2A2F37</Color>
    <Color x:Key="LfColorSurfaceDisabled">#FF24272E</Color>
    <Color x:Key="LfColorOverlay">#99000000</Color>
    <Color x:Key="LfColorShadow">#66000000</Color>

    <!-- ===================== 文本 ===================== -->
    <Color x:Key="LfColorTextPrimary">#FFE9ECF2</Color>
    <Color x:Key="LfColorTextSecondary">#FFA9B2C0</Color>
    <Color x:Key="LfColorTextMuted">#FF7F8896</Color>
    <Color x:Key="LfColorTextDisabled">#FF606876</Color>
    <!-- 深色主题下强调色为亮蓝，其上文字用近黑以保证对比度。 -->
    <Color x:Key="LfColorTextOnAccent">#FF10141A</Color>

    <!-- ===================== 边界 ===================== -->
    <Color x:Key="LfColorBorder">#FF343A44</Color>
    <Color x:Key="LfColorBorderStrong">#FF6B788C</Color>
    <Color x:Key="LfColorDivider">#FF343A44</Color>

    <!-- ===================== 强调色与焦点 ===================== -->
    <Color x:Key="LfColorAccent">#FF5B9CFF</Color>
    <Color x:Key="LfColorAccentHover">#FF7CB0FF</Color>
    <Color x:Key="LfColorAccentPressed">#FF4A8AE8</Color>
    <Color x:Key="LfColorAccentSubtle">#FF17233A</Color>
    <Color x:Key="LfColorFocus">#FF7CB0FF</Color>

    <!-- ===================== 语义状态 ===================== -->
    <Color x:Key="LfColorSuccess">#FF3FBF6A</Color>
    <Color x:Key="LfColorSuccessSubtle">#FF17301F</Color>

    <Color x:Key="LfColorRunning">#FF5B9CFF</Color>
    <Color x:Key="LfColorRunningSubtle">#FF1B2943</Color>

    <Color x:Key="LfColorWarning">#FFE0913A</Color>
    <Color x:Key="LfColorWarningSubtle">#FF352610</Color>

    <Color x:Key="LfColorDanger">#FFF26B62</Color>
    <Color x:Key="LfColorDangerSubtle">#FF411F20</Color>

    <Color x:Key="LfColorUnknown">#FFA9B2C0</Color>
    <Color x:Key="LfColorUnknownSubtle">#FF262A32</Color>

    <Color x:Key="LfColorInfo">#FF4FB3E8</Color>
    <Color x:Key="LfColorInfoSubtle">#FF142E3E</Color>

    <Color x:Key="LfColorDependencyMissing">#FFDCA84F</Color>
    <Color x:Key="LfColorDependencyMissingSubtle">#FF332813</Color>

    <!-- ===================== 画刷 ===================== -->
    <SolidColorBrush x:Key="LfBrushBackground" Color="{StaticResource LfColorBackground}" />
    <SolidColorBrush x:Key="LfBrushSurface" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="LfBrushSurfaceSubtle" Color="{StaticResource LfColorSurfaceSubtle}" />
    <SolidColorBrush x:Key="LfBrushSurfaceRaised" Color="{StaticResource LfColorSurfaceRaised}" />
    <SolidColorBrush x:Key="LfBrushSurfaceDisabled" Color="{StaticResource LfColorSurfaceDisabled}" />
    <SolidColorBrush x:Key="LfBrushOverlay" Color="{StaticResource LfColorOverlay}" />
    <SolidColorBrush x:Key="LfBrushShadow" Color="{StaticResource LfColorShadow}" />

    <SolidColorBrush x:Key="LfBrushTextPrimary" Color="{StaticResource LfColorTextPrimary}" />
    <SolidColorBrush x:Key="LfBrushTextSecondary" Color="{StaticResource LfColorTextSecondary}" />
    <SolidColorBrush x:Key="LfBrushTextMuted" Color="{StaticResource LfColorTextMuted}" />
    <SolidColorBrush x:Key="LfBrushTextDisabled" Color="{StaticResource LfColorTextDisabled}" />
    <SolidColorBrush x:Key="LfBrushTextOnAccent" Color="{StaticResource LfColorTextOnAccent}" />

    <SolidColorBrush x:Key="LfBrushBorder" Color="{StaticResource LfColorBorder}" />
    <SolidColorBrush x:Key="LfBrushBorderStrong" Color="{StaticResource LfColorBorderStrong}" />
    <SolidColorBrush x:Key="LfBrushDivider" Color="{StaticResource LfColorDivider}" />

    <SolidColorBrush x:Key="LfBrushAccent" Color="{StaticResource LfColorAccent}" />
    <SolidColorBrush x:Key="LfBrushAccentHover" Color="{StaticResource LfColorAccentHover}" />
    <SolidColorBrush x:Key="LfBrushAccentPressed" Color="{StaticResource LfColorAccentPressed}" />
    <SolidColorBrush x:Key="LfBrushAccentSubtle" Color="{StaticResource LfColorAccentSubtle}" />
    <SolidColorBrush x:Key="LfBrushFocus" Color="{StaticResource LfColorFocus}" />

    <SolidColorBrush x:Key="LfBrushSuccess" Color="{StaticResource LfColorSuccess}" />
    <SolidColorBrush x:Key="LfBrushSuccessSubtle" Color="{StaticResource LfColorSuccessSubtle}" />
    <SolidColorBrush x:Key="LfBrushRunning" Color="{StaticResource LfColorRunning}" />
    <SolidColorBrush x:Key="LfBrushRunningSubtle" Color="{StaticResource LfColorRunningSubtle}" />
    <SolidColorBrush x:Key="LfBrushWarning" Color="{StaticResource LfColorWarning}" />
    <SolidColorBrush x:Key="LfBrushWarningSubtle" Color="{StaticResource LfColorWarningSubtle}" />
    <SolidColorBrush x:Key="LfBrushDanger" Color="{StaticResource LfColorDanger}" />
    <SolidColorBrush x:Key="LfBrushDangerSubtle" Color="{StaticResource LfColorDangerSubtle}" />
    <SolidColorBrush x:Key="LfBrushUnknown" Color="{StaticResource LfColorUnknown}" />
    <SolidColorBrush x:Key="LfBrushUnknownSubtle" Color="{StaticResource LfColorUnknownSubtle}" />
    <SolidColorBrush x:Key="LfBrushInfo" Color="{StaticResource LfColorInfo}" />
    <SolidColorBrush x:Key="LfBrushInfoSubtle" Color="{StaticResource LfColorInfoSubtle}" />
    <SolidColorBrush x:Key="LfBrushDependencyMissing" Color="{StaticResource LfColorDependencyMissing}" />
    <SolidColorBrush x:Key="LfBrushDependencyMissingSubtle" Color="{StaticResource LfColorDependencyMissingSubtle}" />

    <!-- WPF-UI 控件键映射；规则与理由见 Palette.Light.xaml 同名区块。 -->

    <!-- Button：普通（Secondary/Subtle）按钮 -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource LfColorSurfaceSubtle}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource LfColorSurfaceDisabled}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource LfColorSurfaceDisabled}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource LfColorTextPrimary}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource LfColorTextPrimary}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource LfColorTextPrimary}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource LfColorTextDisabled}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource LfColorBorderStrong}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource LfColorAccent}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource LfColorAccentPressed}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource LfColorBorder}" />

    <!-- Button：主操作（Accent）按钮 -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource LfColorAccent}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource LfColorAccentHover}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource LfColorAccentPressed}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource LfColorTextOnAccent}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource LfColorTextOnAccent}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource LfColorTextOnAccent}" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{StaticResource LfColorAccentPressed}" />

</ResourceDictionary>
