<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LinkForge 设计令牌 · 浅色主题（设计基准）

        依据：docs/LinkForge_UI_Design_Guidelines_V1.1.md §2.2、docs/DECISIONS.md ADR-014 / ADR-015
        本文件与 Palette.Dark.xaml 必须暴露完全相同的令牌键（由 LinkForge.App.Tests 强制校验）。

        对比度要求（已由 DesignTokenTests 自动校验，WCAG 2.1）：
          - TextPrimary / TextSecondary 对任一表面 >= 4.5:1
          - TextMuted 仅用于辅助说明，对任一表面 >= 3.0:1，禁止用于关键数据
          - BorderStrong 用于输入框等交互边界 >= 3.0:1（WCAG 1.4.11 非文本对比）
          - Border / Divider 为结构性细分隔线，可低于 3.0:1
          - 语义色（Success/Warning/Danger/Info/Unknown/DependencyMissing）对任一表面 >= 4.5:1
    -->

    <!-- ===================== 表面 ===================== -->
    <Color x:Key="LfColorBackground">#FFF5F7FA</Color>
    <Color x:Key="LfColorSurface">#FFFFFFFF</Color>
    <Color x:Key="LfColorSurfaceSubtle">#FFF0F3F7</Color>
    <!-- 浅色下 Raised 与 Surface 同色，靠阴影表达层级（规范 §2.1 克制阴影）。 -->
    <Color x:Key="LfColorSurfaceRaised">#FFFFFFFF</Color>
    <Color x:Key="LfColorSurfaceDisabled">#FFEDEFF3</Color>
    <Color x:Key="LfColorOverlay">#66000000</Color>
    <Color x:Key="LfColorShadow">#1F0F172A</Color>

    <!-- ===================== 文本 ===================== -->
    <Color x:Key="LfColorTextPrimary">#FF172033</Color>
    <Color x:Key="LfColorTextSecondary">#FF5F6B7A</Color>
    <Color x:Key="LfColorTextMuted">#FF7C8796</Color>
    <Color x:Key="LfColorTextDisabled">#FFA6AEBA</Color>
    <Color x:Key="LfColorTextOnAccent">#FFFFFFFF</Color>

    <!-- ===================== 边界 ===================== -->
    <Color x:Key="LfColorBorder">#FFDDE3EA</Color>
    <Color x:Key="LfColorBorderStrong">#FF7E8896</Color>
    <Color x:Key="LfColorDivider">#FFDDE3EA</Color>

    <!-- ===================== 强调色与焦点 ===================== -->
    <Color x:Key="LfColorAccent">#FF2563EB</Color>
    <Color x:Key="LfColorAccentHover">#FF1D4ED8</Color>
    <Color x:Key="LfColorAccentPressed">#FF1A43B8</Color>
    <Color x:Key="LfColorAccentSubtle">#FFEDF2FE</Color>
    <Color x:Key="LfColorFocus">#FF1D4ED8</Color>

    <!-- ===================== 语义状态 ===================== -->
    <!-- 每个状态必须同时提供前景色与 Subtle 背景色；不得只用颜色表达状态。 -->
    <Color x:Key="LfColorSuccess">#FF15803D</Color>
    <Color x:Key="LfColorSuccessSubtle">#FFEBF7EF</Color>

    <Color x:Key="LfColorRunning">#FF1D4ED8</Color>
    <Color x:Key="LfColorRunningSubtle">#FFE7EEFD</Color>

    <Color x:Key="LfColorWarning">#FFB45309</Color>
    <Color x:Key="LfColorWarningSubtle">#FFFDF2E7</Color>

    <Color x:Key="LfColorDanger">#FFB91C1C</Color>
    <Color x:Key="LfColorDangerSubtle">#FFFCEAEA</Color>

    <Color x:Key="LfColorUnknown">#FF5F6B7A</Color>
    <Color x:Key="LfColorUnknownSubtle">#FFEEF1F5</Color>

    <Color x:Key="LfColorInfo">#FF0369A1</Color>
    <Color x:Key="LfColorInfoSubtle">#FFE4F0F8</Color>

    <!-- 依赖缺失 / 当前环境不可用：必须区别于"失败"（规范 §5.6）。 -->
    <Color x:Key="LfColorDependencyMissing">#FF7C4A03</Color>
    <Color x:Key="LfColorDependencyMissingSubtle">#FFFBF3E4</Color>

    <!-- ===================== 画刷 ===================== -->
    <SolidColorBrush x:Key="LfBrushBackground" Color="{StaticResource LfColorBackground}" />
    <SolidColorBrush x:Key="LfBrushSurface" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="LfBrushSurfaceSubtle" Color="{StaticResource LfColorSurfaceSubtle}" />
    <SolidColorBrush x:Key="LfBrushSurfaceRaised" Color="{StaticResource LfColorSurfaceRaised}" />
    <SolidColorBrush x:Key="LfBrushSurfaceDisabled" Color="{StaticResource LfColorSurfaceDisabled}" />
    <SolidColorBrush x:Key="LfBrushOverlay" Color="{StaticResource LfColorOverlay}" />
    <SolidColorBrush x:Key="LfBrushShadow" Color="{StaticResource LfColorShadow}" />

    <SolidColorBrush x:Key="LfBrushTextPrimary" Color="{StaticResource LfColorTextPrimary}" />
    <SolidColorBrush x:Key="LfBrushTextSecondary" Color="{StaticResource LfColorTextSecondary}" />
    <SolidColorBrush x:Key="LfBrushTextMuted" Color="{StaticResource LfColorTextMuted}" />
    <SolidColorBrush x:Key="LfBrushTextDisabled" Color="{StaticResource LfColorTextDisabled}" />
    <SolidColorBrush x:Key="LfBrushTextOnAccent" Color="{StaticResource LfColorTextOnAccent}" />

    <SolidColorBrush x:Key="LfBrushBorder" Color="{StaticResource LfColorBorder}" />
    <SolidColorBrush x:Key="LfBrushBorderStrong" Color="{StaticResource LfColorBorderStrong}" />
    <SolidColorBrush x:Key="LfBrushDivider" Color="{StaticResource LfColorDivider}" />

    <SolidColorBrush x:Key="LfBrushAccent" Color="{StaticResource LfColorAccent}" />
    <SolidColorBrush x:Key="LfBrushAccentHover" Color="{StaticResource LfColorAccentHover}" />
    <SolidColorBrush x:Key="LfBrushAccentPressed" Color="{StaticResource LfColorAccentPressed}" />
    <SolidColorBrush x:Key="LfBrushAccentSubtle" Color="{StaticResource LfColorAccentSubtle}" />
    <SolidColorBrush x:Key="LfBrushFocus" Color="{StaticResource LfColorFocus}" />

    <SolidColorBrush x:Key="LfBrushSuccess" Color="{StaticResource LfColorSuccess}" />
    <SolidColorBrush x:Key="LfBrushSuccessSubtle" Color="{StaticResource LfColorSuccessSubtle}" />
    <SolidColorBrush x:Key="LfBrushRunning" Color="{StaticResource LfColorRunning}" />
    <SolidColorBrush x:Key="LfBrushRunningSubtle" Color="{StaticResource LfColorRunningSubtle}" />
    <SolidColorBrush x:Key="LfBrushWarning" Color="{StaticResource LfColorWarning}" />
    <SolidColorBrush x:Key="LfBrushWarningSubtle" Color="{StaticResource LfColorWarningSubtle}" />
    <SolidColorBrush x:Key="LfBrushDanger" Color="{StaticResource LfColorDanger}" />
    <SolidColorBrush x:Key="LfBrushDangerSubtle" Color="{StaticResource LfColorDangerSubtle}" />
    <SolidColorBrush x:Key="LfBrushUnknown" Color="{StaticResource LfColorUnknown}" />
    <SolidColorBrush x:Key="LfBrushUnknownSubtle" Color="{StaticResource LfColorUnknownSubtle}" />
    <SolidColorBrush x:Key="LfBrushInfo" Color="{StaticResource LfColorInfo}" />
    <SolidColorBrush x:Key="LfBrushInfoSubtle" Color="{StaticResource LfColorInfoSubtle}" />
    <SolidColorBrush x:Key="LfBrushDependencyMissing" Color="{StaticResource LfColorDependencyMissing}" />
    <SolidColorBrush x:Key="LfBrushDependencyMissingSubtle" Color="{StaticResource LfColorDependencyMissingSubtle}" />

    <!--
        ===================== WPF-UI 控件键映射 =====================

        依据 ADR-015：业务页面只引用 Lf*；控件库期望的键集中映射，只在此处维护。

        为什么必须映射（真实缺陷记录，2026-10-15 运行时截图发现）：
        WPF-UI 的 Button 模板不读取 Border.Background，而是通过 DynamicResource 读取
        ButtonBackground / ButtonBackgroundPointerOver / ButtonForeground 等自身资源键。
        若只设置按钮的 Background，非交互状态看似正常，但一旦进入 PointerOver/Pressed 状态，
        模板触发器会用控件库的浅色画刷覆盖，深色主题下出现"浅底 + 浅字"、文字不可读。

        映射放在调色板文件内的原因：调色板在主题切换时被整体替换，
        这些键会随新调色板一起重新创建，模板的 DynamicResource 可立即解析到新值。

        键名以 WPF-UI 4.3.0 实测为准（枚举 Button 模板触发器得到的键集合）。
    -->

    <!-- Button：普通（Secondary/Subtle）按钮 -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource LfColorSurfaceSubtle}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource LfColorSurfaceDisabled}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource LfColorSurfaceDisabled}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource LfColorTextPrimary}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource LfColorTextPrimary}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource LfColorTextPrimary}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource LfColorTextDisabled}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource LfColorAccentPressed}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource LfColorBorder}" />

    <!-- Button：主操作（Accent）按钮 -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource LfColorAccent}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource LfColorAccentHover}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource LfColorAccentPressed}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource LfColorTextOnAccent}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource LfColorTextOnAccent}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource LfColorTextOnAccent}" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{StaticResource LfColorAccentPressed}" />

    <!--
        ===================== WPF-UI 语义调色板映射 =====================

        依据 ADR-015 / ADR-018。这里映射的是 WPF-UI 的**语义层**键
        （TextFillColor*、ControlFillColor*、AccentFillColor*、SolidBackgroundFillColor* …），
        而不是逐个控件键。WPF-UI 的所有控件模板都建立在这一层之上，
        因此映射这一层即可让按钮、输入框、下拉框、列表、滚动条、InfoBar 等
        统一跟随 LinkForge 设计令牌，无需逐控件覆盖。

        映射写在调色板内的原因：主题切换时调色板被整体替换，
        这些键随字典一起重建，控件模板的 DynamicResource 立即解析到新值。

        不映射的键（有意保留控件库原值）：
        - ControlFillColorTransparentBrush：必须保持透明。
        - ControlStrokeColorOnAccent*：强调色之上的白色描边，与主题无关。
        - ControlElevationBorderBrush / AccentControlElevationBorderBrush：渐变边框，
          用于 Fluent 立体感；本产品采用"细边框 + 克制层级"（规范 §2.1），
          改由卡片自身的 Border 令牌表达。
    -->

    <!-- 背景与表面 -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource LfColorBackground}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource LfColorBackground}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource LfColorSurfaceSubtle}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource LfColorSurfaceSubtle}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource LfColorSurfaceSubtle}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource LfColorBorder}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource LfColorSurfaceRaised}" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="{StaticResource LfColorSurface}" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource LfColorTextPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource LfColorTextSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource LfColorTextMuted}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource LfColorTextDisabled}" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="{StaticResource LfColorTextOnAccent}" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource LfColorAccent}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource LfColorAccentHover}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource LfColorAccentPressed}" />
    <Color x:Key="AccentFillColorDisabled">#FFDDE3EA</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource LfColorTextOnAccent}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource LfColorTextOnAccent}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="{StaticResource LfColorTextOnAccent}" />

    <!-- 控件填充与描边 -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource LfColorSurfaceSubtle}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource LfColorSurfaceDisabled}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource LfColorSurfaceDisabled}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource LfColorBorder}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource LfColorBorderStrong}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="{StaticResource LfColorTextMuted}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{StaticResource LfColorBorderStrong}" />

    <!-- 分隔线与焦点环 -->
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource LfColorDivider}" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource LfColorFocus}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="{StaticResource LfColorSurface}" />

    <!-- 低强度填充（悬停/轻选中） -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource LfColorSurfaceSubtle}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource LfColorSurfaceSubtle}" />

    <!-- 输入控件（TextBox / PasswordBox / ComboBox 编辑区） -->
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource LfColorTextPrimary}" />
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource LfColorSurfaceSubtle}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource LfColorSurface}" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource LfColorSurfaceDisabled}" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource LfColorTextDisabled}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource LfColorBorder}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource LfColorTextMuted}" />

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource LfColorBorderStrong}" />

    <!-- 系统状态色（InfoBar / 校验提示等复用） -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource LfColorSuccess}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{StaticResource LfColorSuccessSubtle}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource LfColorWarning}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{StaticResource LfColorWarningSubtle}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource LfColorDanger}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{StaticResource LfColorDangerSubtle}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource LfColorAccent}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="{StaticResource LfColorAccentSubtle}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="{StaticResource LfColorTextMuted}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="{StaticResource LfColorUnknownSubtle}" />
    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{StaticResource LfColorSuccessSubtle}" />
    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{StaticResource LfColorWarningSubtle}" />
    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{StaticResource LfColorDangerSubtle}" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{StaticResource LfColorInfoSubtle}" />

</ResourceDictionary>
