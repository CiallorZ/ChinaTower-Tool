<UserControl x:Class="LinkForge.App.Views.Pages.MqttWorkbenchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LinkForge.App.Controls"
             xmlns:presentation="clr-namespace:LinkForge.App.Presentation"
             xmlns:vm="clr-namespace:LinkForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MqttWorkbenchViewModel}"
             Background="Transparent">

    <!--
        MQTT 基础调试器（LF-008 / UI 规范 §4.2、§5.6）。

        左栏：连接参数 -> 订阅 -> 发布；右栏：连接状态 -> 消息流 -> 日志。
        所有状态来自真实 MQTT 传输；断线、认证失败、取消与依赖缺失分别表达，
        不使用任何“演示消息”。

        “暂停显示”只冻结右栏消息列表的刷新，消息仍进入缓冲；
        恢复后一次性补齐，避免用户误判设备没有上报。
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LfBoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="{DynamicResource LfContentPadding}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource LfMqttControlColumnWidth}" />
                <ColumnDefinition Width="{DynamicResource LfMqttWorkspaceGap}" />
                <ColumnDefinition Width="{DynamicResource LfMqttStreamColumnWidth}" />
            </Grid.ColumnDefinitions>

            <!-- ===================== 左栏：连接 / 订阅 / 发布 ===================== -->
            <StackPanel Grid.Column="0">

                <!-- 0. 依赖缺失：必须先于连接表单出现，否则用户会反复重试一个不可能成功的连接。 -->
                <controls:DependencyMissingPanel
                    Margin="{DynamicResource LfBlockSpacing}"
                    DependencyName="{Binding MissingDependencyName}"
                    Impact="{Binding MissingDependencyImpact}"
                    Guidance="{Binding MissingDependencyGuidance}"
                    Visibility="{Binding IsDependencyMissing,
                                         Converter={StaticResource LfBoolToVisibility}}" />

                <!-- 1. Broker 与连接参数 -->
                <Border Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}">
                    <StackPanel>
                        <TextBlock Text="Broker 与连接"
                                   FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />

                        <Grid Margin="{DynamicResource LfBlockSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <controls:LabeledTextBox Grid.Column="0"
                                                     Label="Broker 主机"
                                                     IsRequired="True"
                                                     Text="{Binding Host}"
                                                     Placeholder="127.0.0.1 或 broker.example.com"
                                                     Hint="只填主机名或 IP；不要包含 mqtt:// 或路径。"
                                                     ErrorText="{Binding HostError}"
                                                     IsEnabled="{Binding CanConnect}" />

                            <controls:LabeledTextBox Grid.Column="2"
                                                     Label="端口"
                                                     IsRequired="True"
                                                     Text="{Binding PortText}"
                                                     Hint="明文常见 1883，TLS 常见 8883。"
                                                     ErrorText="{Binding PortError}"
                                                     IsEnabled="{Binding CanConnect}" />
                        </Grid>

                        <controls:LabeledTextBox Label="Client ID"
                                                 IsRequired="True"
                                                 Text="{Binding ClientId}"
                                                 Hint="同一 Broker 上必须唯一；重连前请确认旧会话已清理。"
                                                 ErrorText="{Binding ClientIdError}"
                                                 IsEnabled="{Binding CanConnect}" />

                        <Grid Margin="{DynamicResource LfBlockSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:LabeledTextBox Grid.Column="0"
                                                     Label="用户名（可选）"
                                                     Text="{Binding Username}"
                                                     Hint="不写入日志、历史与导出。"
                                                     IsEnabled="{Binding CanConnect}" />

                            <controls:SecretTextBox Grid.Column="2"
                                                    Label="口令（可选）"
                                                    Secret="{Binding Password, Mode=TwoWay}"
                                                    Placeholder="Broker 口令"
                                                    IsEnabled="{Binding CanConnect}" />
                        </Grid>

                        <Grid Margin="{DynamicResource LfBlockSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:LabeledTextBox Grid.Column="0"
                                                     Label="连接超时（秒）"
                                                     Text="{Binding ConnectTimeoutText}"
                                                     Hint="1–300 秒。"
                                                     ErrorText="{Binding ConnectTimeoutError}"
                                                     IsEnabled="{Binding CanConnect}" />

                            <CheckBox Grid.Column="2"
                                      Content="使用 TLS（始终校验证书）"
                                      IsChecked="{Binding UseTls}"
                                      IsEnabled="{Binding CanConnect}"
                                      VerticalAlignment="Bottom"
                                      Margin="{DynamicResource LfInlineSpacing}"
                                      ToolTip="启用后使用系统信任链验证证书与主机名；不提供跳过校验的开关。" />
                        </Grid>

                        <WrapPanel Margin="{DynamicResource LfSectionSpacing}">
                            <Button Content="连接"
                                    Command="{Binding ConnectCommand}"
                                    MinWidth="{DynamicResource LfActionButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    ToolTip="按当前参数连接 Broker"
                                    AutomationProperties.Name="连接 MQTT Broker" />

                            <Button Content="断开"
                                    Command="{Binding DisconnectCommand}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    Margin="{DynamicResource LfInlineSpacingLeading}"
                                    ToolTip="主动断开当前 Broker 连接"
                                    AutomationProperties.Name="断开 MQTT 连接" />

                            <Button Content="取消"
                                    Command="{Binding CancelCommand}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    Margin="{DynamicResource LfInlineSpacingLeading}"
                                    ToolTip="取消正在进行的连接、断开、订阅或发布"
                                    AutomationProperties.Name="取消 MQTT 操作" />
                        </WrapPanel>

                        <controls:ErrorPanel Margin="{DynamicResource LfBlockSpacing}"
                                             Message="{Binding ErrorMessage}"
                                             Detail="{Binding ErrorHint}"
                                             IsRecoverable="True"
                                             RetryCommand="{Binding ConnectCommand}"
                                             Visibility="{Binding HasError,
                                                                  Converter={StaticResource LfBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 2. 订阅 -->
                <Border Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}"
                        Margin="{DynamicResource LfBlockSpacing}">
                    <StackPanel>
                        <TextBlock Text="订阅"
                                   FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />

                        <Grid Margin="{DynamicResource LfBlockSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:LabeledTextBox Grid.Column="0"
                                                     Label="Topic 过滤器"
                                                     IsRequired="True"
                                                     Text="{Binding SubscribeTopic}"
                                                     Placeholder="device/+/status"
                                                     Hint="支持 + 与 # 通配符。"
                                                     ErrorText="{Binding SubscribeError}"
                                                     IsEnabled="{Binding CanSubscribe}" />

                            <controls:LabeledTextBox Grid.Column="2"
                                                     Label="QoS"
                                                     Text="{Binding SubscribeQosText}"
                                                     Hint="0 / 1 / 2。"
                                                     IsEnabled="{Binding CanSubscribe}" />

                            <Button Grid.Column="3"
                                    Content="订阅"
                                    Command="{Binding SubscribeCommand}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    VerticalAlignment="Bottom"
                                    Margin="{DynamicResource LfInlineSpacingLeading}"
                                    ToolTip="向 Broker 发送订阅请求"
                                    AutomationProperties.Name="订阅 MQTT Topic" />
                        </Grid>

                        <TextBlock Text="已订阅 Topic"
                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                   Foreground="{DynamicResource LfBrushTextSecondary}" />

                        <ListBox ItemsSource="{Binding Subscriptions}"
                                 Height="{DynamicResource LfMqttSubscriptionListHeight}"
                                 Margin="{DynamicResource LfInlineSpacing}"
                                 BorderThickness="{DynamicResource LfBorderThicknessNone}"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <!-- 空列表时折叠，避免留下一块无内容的固定高度空白。 -->
                            <ListBox.Style>
                                <Style TargetType="ListBox"
                                       BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSubscriptions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MqttSubscriptionItem}">
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontFamily="{DynamicResource LfFontFamilyMono}"
                                               FontSize="{DynamicResource LfFontSizeCaption}"
                                               Foreground="{DynamicResource LfBrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <controls:EmptyState Title="尚未订阅"
                                             Description="连接成功后填写 Topic 过滤器并订阅；订阅结果（含被拒绝原因）会显示在此处。">
                            <controls:EmptyState.Style>
                                <Style TargetType="controls:EmptyState"
                                       BasedOn="{StaticResource {x:Type controls:EmptyState}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSubscriptions}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:EmptyState.Style>
                        </controls:EmptyState>
                    </StackPanel>
                </Border>

                <!-- 3. 发布 -->
                <Border Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}"
                        Margin="{DynamicResource LfBlockSpacing}">
                    <StackPanel>
                        <TextBlock Text="发布"
                                   FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />

                        <Grid Margin="{DynamicResource LfBlockSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:LabeledTextBox Grid.Column="0"
                                                     Label="发布 Topic"
                                                     IsRequired="True"
                                                     Text="{Binding PublishTopic}"
                                                     Placeholder="linkforge/demo"
                                                     Hint="发布 Topic 不允许包含 + 或 #。"
                                                     ErrorText="{Binding PublishError}"
                                                     IsEnabled="{Binding CanPublish}" />

                            <controls:LabeledTextBox Grid.Column="2"
                                                     Label="QoS"
                                                     Text="{Binding PublishQosText}"
                                                     Hint="0 / 1 / 2。"
                                                     IsEnabled="{Binding CanPublish}" />
                        </Grid>

                        <TextBlock Text="载荷"
                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                   Foreground="{DynamicResource LfBrushTextSecondary}" />
                        <TextBox Text="{Binding PublishPayload, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="{DynamicResource LfMqttPayloadEditorHeight}"
                                 Margin="{DynamicResource LfInlineSpacing}"
                                 FontFamily="{DynamicResource LfFontFamilyMono}"
                                 FontSize="{DynamicResource LfFontSizeCaption}"
                                 VerticalScrollBarVisibility="Auto"
                                 IsEnabled="{Binding CanPublish}"
                                 ToolTip="载荷会脱敏后进入消息列表、复制与导出；凭据不应写进载荷。" />

                        <WrapPanel Margin="{DynamicResource LfInlineSpacingSm}">
                            <CheckBox Content="Retain"
                                      IsChecked="{Binding Retain}"
                                      IsEnabled="{Binding CanPublish}"
                                      VerticalAlignment="Center"
                                      ToolTip="要求 Broker 保留该 Topic 的最后一条消息。" />

                            <Button Content="发布"
                                    Command="{Binding PublishCommand}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    Margin="{DynamicResource LfInlineSpacingLeading}"
                                    ToolTip="发布当前载荷"
                                    AutomationProperties.Name="发布 MQTT 消息" />

                            <TextBlock Text="{Binding ActionFeedback}"
                                       VerticalAlignment="Center"
                                       Margin="{DynamicResource LfInlineSpacingLeading}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       TextWrapping="Wrap" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== 右栏：状态 / 消息流 / 日志 ===================== -->
            <StackPanel Grid.Column="2">

                <!-- 连接状态摘要：状态、阶段、计数。 -->
                <Border Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:StatusBadge Grid.Column="0"
                                                  TaskState="{Binding State}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ConnectionText}"
                                       Margin="{DynamicResource LfInlineSpacingLeading}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LfBrushTextPrimary}" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding CurrentStage}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <WrapPanel Margin="{DynamicResource LfBlockSpacing}">
                            <TextBlock Text="{Binding MessageCountText}"
                                       Margin="{DynamicResource LfLabelSpacing}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}" />
                            <TextBlock Text="{Binding SubscriptionCountText}"
                                       Margin="{DynamicResource LfLabelSpacing}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}" />
                            <TextBlock Text="{Binding ElapsedText}"
                                       FontFamily="{DynamicResource LfFontFamilyMono}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}" />
                        </WrapPanel>

                        <!--
                            结构化事实：Broker / TLS / 状态 / 订阅。
                            与上方状态标签同处一个卡片，避免“状态 + 结果摘要”
                            两块卡片各画一遍“已完成 / 已连接”，让人误以为有两个结论。
                        -->
                        <ItemsControl ItemsSource="{Binding SummaryItems}"
                                      Margin="{DynamicResource LfInlineSpacing}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type controls:ResultSummaryItem}">
                                    <Grid Margin="{DynamicResource LfInlineSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{DynamicResource LfFactLabelColumnWidth}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                                   Foreground="{DynamicResource LfBrushTextMuted}" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   FontFamily="{DynamicResource LfFontFamilyMono}"
                                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                                   Foreground="{DynamicResource LfBrushTextPrimary}"
                                                   TextWrapping="Wrap" />

                                        <controls:StatusBadge Grid.Column="2"
                                                              DiagnosticStatus="{Binding Status}"
                                                              Visibility="{Binding HasStatus,
                                                                                   Converter={StaticResource LfBoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:TaskProgressPanel Margin="{DynamicResource LfInlineSpacing}"
                                                    TaskState="{Binding State}"
                                                    Stage="{Binding CurrentStage}"
                                                    ElapsedText="{Binding ElapsedText}"
                                                    CancelCommand="{Binding CancelCommand}"
                                                    Visibility="{Binding IsBusy,
                                                                         Converter={StaticResource LfBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 消息工具条 -->
                <Grid Margin="{DynamicResource LfBlockSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:LabeledTextBox Grid.Column="0"
                                             Label="筛选消息"
                                             Text="{Binding FilterText}"
                                             Placeholder="按 Topic 或载荷内容筛选"
                                             Hint="只影响显示与复制/导出范围；原始缓冲仍保留全部消息。" />

                    <WrapPanel Grid.Column="1"
                               VerticalAlignment="Bottom"
                               Margin="{DynamicResource LfInlineSpacingLeading}">
                        <Button Content="{Binding PauseButtonText}"
                                Command="{Binding TogglePauseCommand}"
                                MinWidth="{DynamicResource LfButtonMinWidth}"
                                Height="{DynamicResource LfControlHeight}"
                                ToolTip="暂停只冻结列表刷新，消息仍会记录" />

                        <Button Content="清空"
                                Command="{Binding ClearMessagesCommand}"
                                MinWidth="{DynamicResource LfButtonMinWidth}"
                                Height="{DynamicResource LfControlHeight}"
                                Margin="{DynamicResource LfInlineSpacingLeading}" />

                        <Button Content="复制"
                                Command="{Binding CopyMessagesCommand}"
                                MinWidth="{DynamicResource LfButtonMinWidth}"
                                Height="{DynamicResource LfControlHeight}"
                                Margin="{DynamicResource LfInlineSpacingLeading}"
                                ToolTip="复制当前筛选后的脱敏消息" />

                        <Button Content="导出 JSON"
                                Command="{Binding ExportJsonCommand}"
                                MinWidth="{DynamicResource LfButtonMinWidth}"
                                Height="{DynamicResource LfControlHeight}"
                                Margin="{DynamicResource LfInlineSpacingLeading}" />

                        <Button Content="导出 CSV"
                                Command="{Binding ExportCsvCommand}"
                                MinWidth="{DynamicResource LfButtonMinWidth}"
                                Height="{DynamicResource LfControlHeight}"
                                Margin="{DynamicResource LfInlineSpacingLeading}" />
                    </WrapPanel>
                </Grid>

                <!-- 暂停提示：说明消息没有丢，避免“设备不上报”的误判。 -->
                <Border Background="{DynamicResource LfBrushWarningSubtle}"
                        BorderBrush="{DynamicResource LfBrushWarning}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusControl}"
                        Padding="{DynamicResource LfCardPadding}"
                        Margin="{DynamicResource LfInlineSpacingSm}"
                        Visibility="{Binding IsPaused,
                                             Converter={StaticResource LfBoolToVisibility}}">
                    <TextBlock Text="{Binding PauseNotice}"
                               Foreground="{DynamicResource LfBrushTextPrimary}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 消息流 -->
                <Border Margin="{DynamicResource LfBlockSpacing}"
                        Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}">
                    <StackPanel>
                        <TextBlock Text="消息流"
                                   FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />

                        <!-- 虚拟化：长连接可能累积上千条消息，不能为每条创建完整视觉树。 -->
                        <ListBox ItemsSource="{Binding Messages}"
                                 Height="{DynamicResource LfMqttMessageListHeight}"
                                 Margin="{DynamicResource LfBlockSpacing}"
                                 BorderThickness="{DynamicResource LfBorderThicknessNone}"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <!-- 无消息时折叠列表，让空状态占用这块空间而不是并列显示。 -->
                            <ListBox.Style>
                                <Style TargetType="ListBox"
                                       BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMessages}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type presentation:MqttMessageEntry}">
                                    <Border Margin="{DynamicResource LfInlineSpacing}"
                                            BorderBrush="{DynamicResource LfBrushDivider}"
                                            BorderThickness="{DynamicResource LfDividerTop}"
                                            Padding="{DynamicResource LfInlineSpacing}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TimeText}"
                                                           FontFamily="{DynamicResource LfFontFamilyMono}"
                                                           FontSize="{DynamicResource LfFontSizeCaption}"
                                                           Foreground="{DynamicResource LfBrushTextMuted}" />

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DirectionText}"
                                                           Margin="{DynamicResource LfLabelSpacing}"
                                                           FontSize="{DynamicResource LfFontSizeCaption}"
                                                           Foreground="{DynamicResource LfBrushTextSecondary}" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Topic}"
                                                           FontFamily="{DynamicResource LfFontFamilyMono}"
                                                           FontSize="{DynamicResource LfFontSizeCaption}"
                                                           Foreground="{DynamicResource LfBrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding MetadataText}"
                                                           FontFamily="{DynamicResource LfFontFamilyMono}"
                                                           FontSize="{DynamicResource LfFontSizeCaption}"
                                                           Foreground="{DynamicResource LfBrushTextMuted}" />
                                            </Grid>

                                            <ScrollViewer MaxHeight="{DynamicResource LfMqttMessagePayloadHeight}"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Margin="{DynamicResource LfInlineSpacing}">
                                                <TextBlock Text="{Binding DisplayPayload}"
                                                           FontFamily="{DynamicResource LfFontFamilyMono}"
                                                           FontSize="{DynamicResource LfFontSizeCaption}"
                                                           Foreground="{DynamicResource LfBrushTextPrimary}"
                                                           TextWrapping="Wrap" />
                                            </ScrollViewer>

                                            <TextBlock Text="{Binding PayloadNotice}"
                                                       Margin="{DynamicResource LfInlineSpacing}"
                                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                                       Foreground="{DynamicResource LfBrushWarning}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsPayloadTruncated,
                                                                            Converter={StaticResource LfBoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态：区分“从未连接”“已连接但无消息”“暂停中”。 -->
                        <controls:EmptyState Title="尚无消息"
                                             MinHeight="{DynamicResource LfMqttMessageEmptyHeight}">
                            <controls:EmptyState.Style>
                                <Style TargetType="controls:EmptyState"
                                       BasedOn="{StaticResource {x:Type controls:EmptyState}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Description"
                                            Value="连接 Broker 并订阅 Topic 后，收到的消息会实时显示在这里。" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Description"
                                                    Value="{Binding PauseNotice}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Description"
                                                    Value="已连接但尚未收到消息；可先订阅 Topic 或向该 Topic 发布一条消息验证链路。" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:EmptyState.Style>
                        </controls:EmptyState>
                    </StackPanel>
                </Border>

                <!--
                    日志默认折叠：LogViewer 的自动滚动会调用 ScrollIntoView，
                    在页面级 ScrollViewer 内展开时会把整页滚动到日志处，
                    用户一进入页面就看不到连接状态与消息流。
                -->
                <Expander Header="连接与消息日志"
                          Margin="{DynamicResource LfBlockSpacing}"
                          IsExpanded="False">
                    <controls:LogViewer Height="{DynamicResource LfLogPanelDefaultHeight}"
                                        Entries="{Binding Logs}"
                                        Margin="{DynamicResource LfInlineSpacing}" />
                </Expander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
