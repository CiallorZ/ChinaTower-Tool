<UserControl x:Class="LinkForge.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LinkForge.App.Controls"
             xmlns:vm="clr-namespace:LinkForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LfBoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{DynamicResource LfContentPadding}">
            <StackPanel>
            <Border Background="{DynamicResource LfBrushSurface}"
                    BorderBrush="{DynamicResource LfBrushBorder}"
                    BorderThickness="{DynamicResource LfBorderThickness}"
                    CornerRadius="{DynamicResource LfRadiusPanel}"
                    Padding="{DynamicResource LfCardPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ProductName}"
                                   FontSize="{DynamicResource LfFontSizePageTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />
                        <TextBlock Text="{Binding Version}"
                                   Margin="{DynamicResource LfInlineSpacing}"
                                   FontFamily="{DynamicResource LfFontFamilyMono}"
                                   FontSize="{DynamicResource LfFontSizeBodyLarge}"
                                   Foreground="{DynamicResource LfBrushTextSecondary}" />
                        <TextBlock Text="{Binding Commit, StringFormat=提交：{0}}"
                                   Margin="{DynamicResource LfInlineSpacing}"
                                   FontFamily="{DynamicResource LfFontFamilyMono}"
                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                   Foreground="{DynamicResource LfBrushTextMuted}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="重新读取"
                            Command="{Binding LoadCommand}"
                            MinWidth="{DynamicResource LfButtonMinWidth}"
                            Height="{DynamicResource LfControlHeight}"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="重新读取版本与安装信息" />
                </Grid>
            </Border>

            <controls:LoadingState Margin="{DynamicResource LfBlockSpacing}"
                                   Message="正在读取版本与安装信息…"
                                   Detail="读取程序集、运行时、安装目录与本地 Authenticode 签名状态。"
                                   Visibility="{Binding IsLoading,
                                                        Converter={StaticResource LfBoolToVisibility}}" />

            <controls:ErrorPanel Margin="{DynamicResource LfBlockSpacing}"
                                 Message="版本与安装信息读取失败"
                                 Detail="{Binding ErrorMessage}"
                                 IsRecoverable="True"
                                 RetryCommand="{Binding LoadCommand}"
                                 Visibility="{Binding ErrorMessage,
                                                      Converter={StaticResource LfNonEmptyToVisibility}}" />

            <controls:EmptyState Title="尚未读取版本信息"
                                 Description="点击“重新读取”获取当前程序集、安装形态与签名事实。"
                                 ActionText="读取版本信息"
                                 ActionCommand="{Binding LoadCommand}">
                <controls:EmptyState.Style>
                    <Style TargetType="controls:EmptyState"
                           BasedOn="{StaticResource {x:Type controls:EmptyState}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasLoaded}" Value="False" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding ErrorMessage}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyState.Style>
            </controls:EmptyState>

            <StackPanel Visibility="{Binding HasLoaded,
                                             Converter={StaticResource LfBoolToVisibility}}">
                <Border Background="{DynamicResource LfBrushWarningSubtle}"
                        BorderBrush="{DynamicResource LfBrushWarning}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusControl}"
                        Padding="{DynamicResource LfCardPadding}"
                        Margin="{DynamicResource LfBlockSpacing}"
                        Visibility="{Binding HasSignatureWarning,
                                             Converter={StaticResource LfBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="发布签名状态"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />
                        <TextBlock Text="{Binding SignatureSummary}"
                                   Margin="{DynamicResource LfInlineSpacing}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />
                        <ItemsControl ItemsSource="{Binding SignatureNotes}"
                                      Margin="{DynamicResource LfInlineSpacing}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=• {0}}"
                                               Margin="{DynamicResource LfInlineSpacing}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource LfBrushTextSecondary}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}"
                        Margin="{DynamicResource LfBlockSpacing}">
                    <StackPanel>
                        <TextBlock Text="运行环境与安装事实"
                                   FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />

                        <ItemsControl ItemsSource="{Binding Facts}"
                                      Margin="{DynamicResource LfInlineSpacing}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{DynamicResource LfRowSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{DynamicResource LfFactLabelColumnWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                                   Foreground="{DynamicResource LfBrushTextMuted}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{DynamicResource LfFontFamilyMono}"
                                                   Foreground="{DynamicResource LfBrushTextPrimary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource LfBrushSurfaceSubtle}"
                        BorderBrush="{DynamicResource LfBrushDivider}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusControl}"
                        Padding="{DynamicResource LfCardPadding}"
                        Margin="{DynamicResource LfBlockSpacing}">
                    <StackPanel>
                        <TextBlock Text="更新与诊断包边界"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />
                        <TextBlock Text="V1.0 不在线检查更新，也不伪造“已是最新版本”。项目主页提供发布说明与安装包下载入口。当前诊断包导出尚未实现；此页只提供可核对的版本、环境、目录与签名事实。"
                                   Margin="{DynamicResource LfInlineSpacing}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource LfBrushTextSecondary}" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="AboutActionBar"
                Grid.Row="1"
                Background="{DynamicResource LfBrushSurface}"
                BorderBrush="{DynamicResource LfBrushDivider}"
                BorderThickness="{DynamicResource LfBorderThickness}"
                CornerRadius="{DynamicResource LfRadiusPanel}"
                Padding="{DynamicResource LfCardPadding}"
                Margin="{DynamicResource LfContentPadding}"
                Visibility="{Binding HasLoaded,
                                     Converter={StaticResource LfBoolToVisibility}}">
            <StackPanel>
                <WrapPanel>
                    <Button Content="复制版本与诊断信息"
                            Command="{Binding CopySummaryCommand}"
                            MinWidth="{DynamicResource LfActionButtonMinWidth}"
                            Height="{DynamicResource LfControlHeight}"
                            AutomationProperties.Name="复制版本与诊断信息" />
                    <Button Content="打开数据目录"
                            Command="{Binding OpenDataDirectoryCommand}"
                            MinWidth="{DynamicResource LfButtonMinWidth}"
                            Height="{DynamicResource LfControlHeight}"
                            Margin="{DynamicResource LfInlineSpacingLeading}" />
                    <Button Content="打开日志目录"
                            Command="{Binding OpenLogsDirectoryCommand}"
                            MinWidth="{DynamicResource LfButtonMinWidth}"
                            Height="{DynamicResource LfControlHeight}"
                            Margin="{DynamicResource LfInlineSpacingLeading}" />
                    <Button Content="打开项目主页"
                            Command="{Binding OpenRepositoryCommand}"
                            MinWidth="{DynamicResource LfButtonMinWidth}"
                            Height="{DynamicResource LfControlHeight}"
                            Margin="{DynamicResource LfInlineSpacingLeading}" />
                </WrapPanel>

                <TextBlock Text="{Binding ActionFeedback}"
                           Margin="{DynamicResource LfBlockSpacing}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource LfBrushTextSecondary}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
