<UserControl x:Class="LinkForge.App.Views.Pages.NetworkDiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LinkForge.App.Controls"
             xmlns:domain="clr-namespace:LinkForge.Domain.Diagnostics;assembly=LinkForge.Domain"
             xmlns:vm="clr-namespace:LinkForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NetworkDiagnosticsViewModel}"
             Background="Transparent">

    <!--
        网络诊断页（UI 规范 §4.2 / §4.6）。

        结构固定为：参数 -> 授权/校验 -> 主操作 -> 运行状态 -> 结构化结论 -> 原始日志。
        结论先于原始输出；ICMP 无响应与 Traceroute 中间跳点无响应都由适配器
        返回 Unknown 并说明“不能证明离线”，页面不自行改写这个语义。
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LfBoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="{DynamicResource LfContentPadding}">
        <StackPanel>

            <!-- ===== 1. 目标与参数 ===== -->
            <Border Background="{DynamicResource LfBrushSurface}"
                    BorderBrush="{DynamicResource LfBrushBorder}"
                    BorderThickness="{DynamicResource LfBorderThickness}"
                    CornerRadius="{DynamicResource LfRadiusPanel}"
                    Padding="{DynamicResource LfCardPadding}">
                <StackPanel>
                    <TextBlock Text="目标与检测类型"
                               FontSize="{DynamicResource LfFontSizeSectionTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LfBrushTextPrimary}" />

                    <Grid Margin="{DynamicResource LfBlockSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="检测类型"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       FontSize="{DynamicResource LfFontSizeCaption}" />

                            <ComboBox ItemsSource="{Binding Tools}"
                                      SelectedItem="{Binding SelectedTool}"
                                      DisplayMemberPath="Title"
                                      Height="{DynamicResource LfControlHeight}"
                                      Margin="{DynamicResource LfInlineSpacing}"
                                      IsEnabled="{Binding CanStart}"
                                      ToolTip="选择要执行的单个网络探测；不会自动扫描其他端口"
                                      AutomationProperties.Name="检测类型" />

                            <TextBlock Text="{Binding SelectedTool.Description}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="{DynamicResource LfOptionHintSpacing}" />
                        </StackPanel>

                        <controls:LabeledTextBox Grid.Column="2"
                                                 Label="目标"
                                                 IsRequired="{Binding RequiresTarget}"
                                                 Text="{Binding Target}"
                                                 Placeholder="例如 10.0.0.8 或 camera.example.com"
                                                 Hint="只填写主机名、域名或 IP；不要包含 http://、路径或凭据。"
                                                 ErrorText="{Binding TargetError}"
                                                 IsEnabled="{Binding CanStart}"
                                                 Visibility="{Binding RequiresTarget,
                                                                      Converter={StaticResource LfBoolToVisibility}}" />

                        <TextBlock Grid.Column="2"
                                   Text="本机网络模式无需目标地址。"
                                   Foreground="{DynamicResource LfBrushTextSecondary}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RequiresTarget}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 高级参数：默认展开但保持紧凑，避免“高级”藏着关键的超时。 -->
                    <Expander Header="高级参数"
                              IsExpanded="True"
                              Margin="{DynamicResource LfBlockSpacing}"
                              Foreground="{DynamicResource LfBrushTextPrimary}">
                        <Grid Margin="{DynamicResource LfBlockSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:LabeledTextBox Grid.Column="0"
                                                     Label="TCP 端口"
                                                     Text="{Binding PortText}"
                                                     Hint="仅 TCP 端口检测使用。"
                                                     ErrorText="{Binding PortError}"
                                                     IsEnabled="{Binding CanStart}"
                                                     Visibility="{Binding RequiresPort,
                                                                          Converter={StaticResource LfBoolToVisibility}}" />

                            <controls:LabeledTextBox Grid.Column="2"
                                                     Label="超时（秒）"
                                                     Text="{Binding TimeoutText}"
                                                     Hint="1–60 秒；超时与失败会分别显示。"
                                                     ErrorText="{Binding TimeoutError}"
                                                     IsEnabled="{Binding CanStart}" />

                            <controls:LabeledTextBox Grid.Column="4"
                                                     Label="最大跳数"
                                                     Text="{Binding MaxHopsText}"
                                                     Hint="仅 Traceroute 使用，1–30。"
                                                     ErrorText="{Binding MaxHopsError}"
                                                     IsEnabled="{Binding CanStart}"
                                                     Visibility="{Binding RequiresMaxHops,
                                                                          Converter={StaticResource LfBoolToVisibility}}" />
                        </Grid>
                    </Expander>

                    <!-- 授权确认：只对外部目标出现；文案描述范围与影响，不是笼统“确定继续”。 -->
                    <Border Background="{DynamicResource LfBrushWarningSubtle}"
                            BorderBrush="{DynamicResource LfBrushWarning}"
                            BorderThickness="{DynamicResource LfBorderThickness}"
                            CornerRadius="{DynamicResource LfRadiusControl}"
                            Padding="{DynamicResource LfCardPadding}"
                            Margin="{DynamicResource LfAuthorizationSpacing}"
                            Visibility="{Binding RequiresAuthorization,
                                                 Converter={StaticResource LfBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="授权确认"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LfBrushTextPrimary}" />

                            <TextBlock Text="将对上述外部目标发起网络探测。请确认你已获得该目标所有者的测试授权；本工具不会自动扩大端口或网段范围。"
                                       Margin="{DynamicResource LfInlineSpacing}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       TextWrapping="Wrap" />

                            <CheckBox Content="我确认已获得对该目标的测试授权"
                                      IsChecked="{Binding IsAuthorized}"
                                      IsEnabled="{Binding CanStart}"
                                      Margin="{DynamicResource LfInlineSpacing}"
                                      AutomationProperties.Name="确认已获得测试授权" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="{DynamicResource LfSectionSpacing}">
                        <Button Content="开始检测"
                                Command="{Binding RunCommand}"
                                MinWidth="{DynamicResource LfActionButtonMinWidth}"
                                Height="{DynamicResource LfControlHeight}"
                                ToolTip="按当前参数执行一次网络探测"
                                AutomationProperties.Name="开始网络检测" />

                        <Button Content="停止"
                                Command="{Binding CancelCommand}"
                                MinWidth="{DynamicResource LfButtonMinWidth}"
                                Height="{DynamicResource LfControlHeight}"
                                Margin="{DynamicResource LfInlineSpacingLeading}"
                                ToolTip="取消正在运行的网络探测"
                                AutomationProperties.Name="停止网络检测" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== 2. 运行状态 ===== -->
            <controls:TaskProgressPanel Margin="{DynamicResource LfBlockSpacing}"
                                        TaskState="{Binding State}"
                                        Stage="{Binding CurrentStage}"
                                        ElapsedText="{Binding ElapsedText}"
                                        CancelCommand="{Binding CancelCommand}"
                                        Visibility="{Binding IsRunning,
                                                             Converter={StaticResource LfBoolToVisibility}}" />

            <!-- ===== 3. 结论摘要 ===== -->
            <controls:ResultSummary Margin="{DynamicResource LfBlockSpacing}"
                                    TaskState="{Binding State}"
                                    Conclusion="{Binding Conclusion}"
                                    Note="{Binding ConclusionNote}"
                                    Items="{Binding SummaryItems}"
                                    Visibility="{Binding HasResult,
                                                         Converter={StaticResource LfBoolToVisibility}}" />

            <!-- 结构化步骤/事实：先于原始日志。 -->
            <Border Margin="{DynamicResource LfBlockSpacing}"
                    Background="{DynamicResource LfBrushSurface}"
                    BorderBrush="{DynamicResource LfBrushBorder}"
                    BorderThickness="{DynamicResource LfBorderThickness}"
                    CornerRadius="{DynamicResource LfRadiusPanel}"
                    Padding="{DynamicResource LfCardPadding}"
                    Visibility="{Binding HasResult,
                                         Converter={StaticResource LfBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="结构化结果"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LfBrushTextPrimary}" />

                    <ScrollViewer MaxHeight="{DynamicResource LfBusinessResultMaxHeight}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="{DynamicResource LfInlineSpacing}">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type domain:DiagnosticStepResult}">
                                    <Border Margin="{DynamicResource LfRowSpacing}"
                                            BorderBrush="{DynamicResource LfBrushDivider}"
                                            BorderThickness="{DynamicResource LfDividerTop}"
                                            Padding="{DynamicResource LfInlineSpacing}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <controls:StatusBadge Grid.Column="0"
                                                                      DiagnosticStatus="{Binding Status}"
                                                                      Margin="{DynamicResource LfLabelSpacing}" />

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DurationText}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource LfFontFamilyMono}"
                                                           FontSize="{DynamicResource LfFontSizeCaption}"
                                                           Foreground="{DynamicResource LfBrushTextSecondary}" />
                                            </Grid>

                                            <TextBlock Text="{Binding Summary}"
                                                       Margin="{DynamicResource LfInlineSpacing}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource LfBrushTextSecondary}" />

                                            <ItemsControl ItemsSource="{Binding FactItems}"
                                                          Margin="{DynamicResource LfInlineSpacing}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type domain:DiagnosticFact}">
                                                        <Grid Margin="{DynamicResource LfInlineSpacing}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{DynamicResource LfFactLabelColumnWidth}" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Label}"
                                                                       Foreground="{DynamicResource LfBrushTextMuted}"
                                                                       FontSize="{DynamicResource LfFontSizeCaption}" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Value}"
                                                                       FontFamily="{DynamicResource LfFontFamilyMono}"
                                                                       Foreground="{DynamicResource LfBrushTextPrimary}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding NextStepSuggestion}"
                                                       Margin="{DynamicResource LfInlineSpacing}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                                       Visibility="{Binding HasSuggestion,
                                                                            Converter={StaticResource LfBoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ===== 4. 导出/复制 ===== -->
            <WrapPanel Margin="{DynamicResource LfBlockSpacing}"
                       Visibility="{Binding HasResult,
                                            Converter={StaticResource LfBoolToVisibility}}">
                <Button Content="复制脱敏摘要"
                        Command="{Binding CopySummaryCommand}"
                        MinWidth="{DynamicResource LfActionButtonMinWidth}"
                        Height="{DynamicResource LfControlHeight}"
                        ToolTip="复制结论与事实；复制前统一脱敏" />

                <Button Content="导出 JSON"
                        Command="{Binding ExportCommand}"
                        MinWidth="{DynamicResource LfButtonMinWidth}"
                        Height="{DynamicResource LfControlHeight}"
                        Margin="{DynamicResource LfInlineSpacingLeading}"
                        ToolTip="导出结构化结果；导出前统一脱敏" />

                <TextBlock Text="{Binding ActionFeedback}"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource LfInlineSpacingLeading}"
                           FontSize="{DynamicResource LfFontSizeCaption}"
                           Foreground="{DynamicResource LfBrushTextSecondary}"
                           TextWrapping="Wrap" />
            </WrapPanel>

            <!-- ===== 5. 原始输出 ===== -->
            <Expander Header="原始输出与日志"
                      Margin="{DynamicResource LfBlockSpacing}"
                      Visibility="{Binding HasResult,
                                           Converter={StaticResource LfBoolToVisibility}}">
                <controls:LogViewer Height="{DynamicResource LfLogPanelDefaultHeight}"
                                    Entries="{Binding Logs}"
                                    Margin="{DynamicResource LfInlineSpacing}" />
            </Expander>

            <!-- 初始空状态：说明本页做什么、如何开始。 -->
            <controls:EmptyState Margin="{DynamicResource LfBlockSpacing}"
                                 Title="尚未运行网络诊断"
                                 Description="选择检测类型、填写目标并点击“开始检测”。ICMP 无响应不会直接判定设备离线；扫描范围始终可见且可取消。">
                <controls:EmptyState.Style>
                    <Style TargetType="controls:EmptyState"
                           BasedOn="{StaticResource {x:Type controls:EmptyState}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasResult}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyState.Style>
            </controls:EmptyState>

        </StackPanel>
    </ScrollViewer>
</UserControl>
