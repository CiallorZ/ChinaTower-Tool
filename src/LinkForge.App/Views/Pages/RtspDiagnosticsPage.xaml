<UserControl x:Class="LinkForge.App.Views.Pages.RtspDiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LinkForge.App.Controls"
             xmlns:domain="clr-namespace:LinkForge.Domain.Diagnostics;assembly=LinkForge.Domain"
             xmlns:vm="clr-namespace:LinkForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RtspDiagnosticsViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LfBoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="{DynamicResource LfContentPadding}">
        <StackPanel>
            <Border Background="{DynamicResource LfBrushSurface}"
                    BorderBrush="{DynamicResource LfBrushBorder}"
                    BorderThickness="{DynamicResource LfBorderThickness}"
                    CornerRadius="{DynamicResource LfRadiusPanel}"
                    Padding="{DynamicResource LfCardPadding}">
                <StackPanel>
                    <TextBlock Text="RTSP 目标与信令"
                               FontSize="{DynamicResource LfFontSizeSectionTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LfBrushTextPrimary}" />

                    <controls:LabeledTextBox Label="RTSP URL"
                                             IsRequired="True"
                                             Text="{Binding Url}"
                                             Placeholder="rtsp://user:password@camera:554/Streaming/Channels/101"
                                             Hint="支持 rtsp:// 与 rtsps://；凭据只用于请求，界面与导出会脱敏。"
                                             ErrorText="{Binding UrlError}"
                                             IsEnabled="{Binding CanStart}"
                                             Margin="{DynamicResource LfBlockSpacing}" />

                    <Grid Margin="{DynamicResource LfBlockSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="脱敏后的目标"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}" />
                            <TextBlock Text="{Binding RedactedUrl}"
                                       Margin="{DynamicResource LfOptionHintSpacing}"
                                       FontFamily="{DynamicResource LfFontFamilyMono}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource LfBrushTextPrimary}" />
                        </StackPanel>

                        <controls:LabeledTextBox Grid.Column="2"
                                                 Label="超时（秒）"
                                                 Text="{Binding TimeoutText}"
                                                 Hint="1–60 秒；超时与失败分别显示。"
                                                 ErrorText="{Binding TimeoutError}"
                                                 IsEnabled="{Binding CanStart}" />
                    </Grid>

                    <Border Background="{DynamicResource LfBrushWarningSubtle}"
                            BorderBrush="{DynamicResource LfBrushWarning}"
                            BorderThickness="{DynamicResource LfBorderThickness}"
                            CornerRadius="{DynamicResource LfRadiusControl}"
                            Padding="{DynamicResource LfCardPadding}"
                            Margin="{DynamicResource LfAuthorizationSpacing}"
                            Visibility="{Binding RequiresAuthorization,
                                                 Converter={StaticResource LfBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="授权确认"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LfBrushTextPrimary}" />
                            <TextBlock Text="将对上述外部视频目标发起 RTSP 信令探测。请确认你已获得该目标所有者的测试授权；本工具不会自动扩大端口或网段范围，也不会执行 SETUP/PLAY 或媒体解码。"
                                       Margin="{DynamicResource LfInlineSpacing}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       TextWrapping="Wrap" />
                            <CheckBox Content="我确认已获得对该目标的测试授权"
                                      IsChecked="{Binding IsAuthorized}"
                                      IsEnabled="{Binding CanStart}"
                                      Margin="{DynamicResource LfInlineSpacing}" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="{DynamicResource LfSectionSpacing}">
                        <Button Content="开始诊断"
                                Command="{Binding RunCommand}"
                                MinWidth="{DynamicResource LfActionButtonMinWidth}"
                                Height="{DynamicResource LfControlHeight}"
                                ToolTip="执行 DNS、TCP、OPTIONS、DESCRIBE 与 SDP 解析" />
                        <Button Content="停止"
                                Command="{Binding CancelCommand}"
                                MinWidth="{DynamicResource LfButtonMinWidth}"
                                Height="{DynamicResource LfControlHeight}"
                                Margin="{DynamicResource LfInlineSpacingLeading}"
                                ToolTip="取消正在运行的 RTSP 诊断" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <controls:TaskProgressPanel Margin="{DynamicResource LfBlockSpacing}"
                                        TaskState="{Binding State}"
                                        Stage="{Binding CurrentStage}"
                                        ElapsedText="{Binding ElapsedText}"
                                        CancelCommand="{Binding CancelCommand}"
                                        Visibility="{Binding IsRunning,
                                                             Converter={StaticResource LfBoolToVisibility}}" />

            <controls:ResultSummary Margin="{DynamicResource LfBlockSpacing}"
                                    TaskState="{Binding State}"
                                    Conclusion="{Binding Conclusion}"
                                    Note="{Binding ConclusionNote}"
                                    Items="{Binding SummaryItems}"
                                    Visibility="{Binding HasResult,
                                                         Converter={StaticResource LfBoolToVisibility}}" />

            <Border Margin="{DynamicResource LfBlockSpacing}"
                    Background="{DynamicResource LfBrushSurface}"
                    BorderBrush="{DynamicResource LfBrushBorder}"
                    BorderThickness="{DynamicResource LfBorderThickness}"
                    CornerRadius="{DynamicResource LfRadiusPanel}"
                    Padding="{DynamicResource LfCardPadding}"
                    Visibility="{Binding HasResult,
                                         Converter={StaticResource LfBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="结构化阶段结果"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LfBrushTextPrimary}" />

                    <ScrollViewer MaxHeight="{DynamicResource LfBusinessResultMaxHeight}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="{DynamicResource LfInlineSpacing}">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type domain:DiagnosticStepResult}">
                                    <Border Margin="{DynamicResource LfRowSpacing}"
                                            BorderBrush="{DynamicResource LfBrushDivider}"
                                            BorderThickness="{DynamicResource LfDividerTop}"
                                            Padding="{DynamicResource LfInlineSpacing}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:StatusBadge Grid.Column="0"
                                                                      DiagnosticStatus="{Binding Status}"
                                                                      Margin="{DynamicResource LfLabelSpacing}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource LfBrushTextPrimary}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DurationText}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource LfFontFamilyMono}"
                                                           FontSize="{DynamicResource LfFontSizeCaption}"
                                                           Foreground="{DynamicResource LfBrushTextSecondary}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Summary}"
                                                       Margin="{DynamicResource LfInlineSpacing}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource LfBrushTextSecondary}" />
                                            <ItemsControl ItemsSource="{Binding FactItems}"
                                                          Margin="{DynamicResource LfInlineSpacing}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type domain:DiagnosticFact}">
                                                        <Grid Margin="{DynamicResource LfInlineSpacing}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{DynamicResource LfFactLabelColumnWidth}" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Label}"
                                                                       Foreground="{DynamicResource LfBrushTextMuted}"
                                                                       FontSize="{DynamicResource LfFontSizeCaption}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Value}"
                                                                       FontFamily="{DynamicResource LfFontFamilyMono}"
                                                                       Foreground="{DynamicResource LfBrushTextPrimary}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding NextStepSuggestion}"
                                                       Margin="{DynamicResource LfInlineSpacing}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                                       Visibility="{Binding HasSuggestion,
                                                                            Converter={StaticResource LfBoolToVisibility}}" />
                                            <TextBlock Text="{Binding SkipReason}"
                                                       Margin="{DynamicResource LfInlineSpacing}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                                       Visibility="{Binding RequiresSkipReason,
                                                                            Converter={StaticResource LfBoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <WrapPanel Margin="{DynamicResource LfBlockSpacing}"
                       Visibility="{Binding HasResult,
                                            Converter={StaticResource LfBoolToVisibility}}">
                <Button Content="复制脱敏摘要"
                        Command="{Binding CopySummaryCommand}"
                        MinWidth="{DynamicResource LfActionButtonMinWidth}"
                        Height="{DynamicResource LfControlHeight}" />
                <Button Content="导出 JSON"
                        Command="{Binding ExportCommand}"
                        MinWidth="{DynamicResource LfButtonMinWidth}"
                        Height="{DynamicResource LfControlHeight}"
                        Margin="{DynamicResource LfInlineSpacingLeading}" />
                <TextBlock Text="{Binding ActionFeedback}"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource LfInlineSpacingLeading}"
                           FontSize="{DynamicResource LfFontSizeCaption}"
                           Foreground="{DynamicResource LfBrushTextSecondary}"
                           TextWrapping="Wrap" />
            </WrapPanel>

            <Expander Header="原始信令与日志"
                      Margin="{DynamicResource LfBlockSpacing}"
                      Visibility="{Binding HasResult,
                                           Converter={StaticResource LfBoolToVisibility}}">
                <controls:LogViewer Height="{DynamicResource LfLogPanelDefaultHeight}"
                                    Entries="{Binding Logs}"
                                    Margin="{DynamicResource LfInlineSpacing}" />
            </Expander>

            <controls:EmptyState Margin="{DynamicResource LfBlockSpacing}"
                                 Title="尚未运行 RTSP 诊断"
                                 Description="填写 RTSP URL 并点击“开始诊断”。本页验证 DNS、TCP、OPTIONS、DESCRIBE 与 SDP；媒体接收/解码/首帧不会伪造为已执行。">
                <controls:EmptyState.Style>
                    <Style TargetType="controls:EmptyState"
                           BasedOn="{StaticResource {x:Type controls:EmptyState}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasResult}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyState.Style>
            </controls:EmptyState>
        </StackPanel>
    </ScrollViewer>
</UserControl>
