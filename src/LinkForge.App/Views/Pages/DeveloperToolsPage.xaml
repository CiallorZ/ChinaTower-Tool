<UserControl x:Class="LinkForge.App.Views.Pages.DeveloperToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LinkForge.App.Controls"
             xmlns:presentation="clr-namespace:LinkForge.App.Presentation"
             xmlns:vm="clr-namespace:LinkForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DeveloperToolsViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LfBoolToVisibility" />
        <presentation:NonEmptyToVisibilityConverter x:Key="LfNonEmptyToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="{DynamicResource LfContentPadding}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource LfDeveloperToolColumnWidth}" />
                <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource LfBrushSurface}"
                    BorderBrush="{DynamicResource LfBrushBorder}"
                    BorderThickness="{DynamicResource LfBorderThickness}"
                    CornerRadius="{DynamicResource LfRadiusPanel}"
                    Padding="{DynamicResource LfCardPadding}">
                <StackPanel>
                    <TextBlock Text="离线转换工具"
                               FontSize="{DynamicResource LfFontSizeSectionTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LfBrushTextPrimary}" />
                    <ListBox ItemsSource="{Binding Tools}"
                             SelectedItem="{Binding SelectedTool}"
                             ItemContainerStyle="{StaticResource LfDeveloperToolListBoxItemStyle}"
                             MaxHeight="{DynamicResource LfDeveloperToolListMaxHeight}"
                             Margin="{DynamicResource LfBlockSpacing}"
                             BorderThickness="{DynamicResource LfBorderThicknessNone}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type presentation:DeveloperToolDescriptor}">
                                <TextBlock Text="{Binding Name}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource LfBrushTextPrimary}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="不访问网络、不读取文件；输入和结果仅留在当前会话。"
                               Margin="{DynamicResource LfInlineSpacingSm}"
                               FontSize="{DynamicResource LfFontSizeCaption}"
                               Foreground="{DynamicResource LfBrushTextMuted}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTool.Name}"
                                   FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />
                        <TextBlock Text="{Binding SelectedTool.Description}"
                                   Margin="{DynamicResource LfInlineSpacing}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource LfBrushTextSecondary}" />
                        <!--
                            输入区只保留一个可多行编辑的输入控件。
                            这里不能用 LabeledTextBox：它的模板内含单行 TextBox，
                            与下方多行编辑器同时绑定 Input 会出现"同一字段两个输入框"，
                            两处内容看起来不同步（阶段 05 自查时真实发现）。
                            标签/必填/错误就近显示的顺序与 LabeledTextBox 保持一致。
                        -->
                        <StackPanel Margin="{DynamicResource LfBlockSpacing}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedTool.InputLabel}"
                                           Foreground="{DynamicResource LfBrushTextSecondary}"
                                           FontSize="{DynamicResource LfFontSizeCaption}" />
                                <TextBlock Text="*"
                                           Foreground="{DynamicResource LfBrushDanger}"
                                           FontSize="{DynamicResource LfFontSizeCaption}"
                                           Margin="{DynamicResource LfInlineSpacingXxs}"
                                           Visibility="{Binding SelectedTool.RequiresInput,
                                                                Converter={StaticResource LfBoolToVisibility}}" />
                            </StackPanel>

                            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="{DynamicResource LfDeveloperEditorHeight}"
                                     Margin="{DynamicResource LfInlineSpacing}"
                                     FontFamily="{DynamicResource LfFontFamilyMono}"
                                     FontSize="{DynamicResource LfFontSizeCaption}"
                                     VerticalScrollBarVisibility="Auto"
                                     IsEnabled="{Binding CanExecute}"
                                     AutomationProperties.Name="{Binding SelectedTool.InputLabel}" />

                            <!-- 错误优先于说明，与 LabeledTextBox 的取舍一致（规范 §5.2）。 -->
                            <TextBlock Text="{Binding InputError}"
                                       Foreground="{DynamicResource LfBrushDanger}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Margin="{DynamicResource LfInlineSpacing}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding InputError,
                                                            Converter={StaticResource LfNonEmptyToVisibility}}" />
                            <TextBlock Text="{Binding SelectedTool.Hint}"
                                       Foreground="{DynamicResource LfBrushTextMuted}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Margin="{DynamicResource LfSectionSpacing}">
                            <Button Content="{Binding SelectedTool.ActionLabel}"
                                    Command="{Binding RunCommand}"
                                    MinWidth="{DynamicResource LfActionButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}" />
                            <Button Content="停止"
                                    Command="{Binding CancelCommand}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    Margin="{DynamicResource LfInlineSpacingLeading}" />
                            <Button Content="清空"
                                    Command="{Binding ClearCommand}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    Margin="{DynamicResource LfInlineSpacingLeading}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <controls:TaskProgressPanel Margin="{DynamicResource LfBlockSpacing}"
                                            TaskState="{Binding State}"
                                            Stage="{Binding CurrentStage}"
                                            ElapsedText="{Binding ElapsedText}"
                                            CancelCommand="{Binding CancelCommand}"
                                            Visibility="{Binding IsRunning,
                                                                 Converter={StaticResource LfBoolToVisibility}}" />

                <Border Background="{DynamicResource LfBrushWarningSubtle}"
                        BorderBrush="{DynamicResource LfBrushWarning}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}"
                        Margin="{DynamicResource LfBlockSpacing}"
                        Visibility="{Binding IsWarning,
                                             Converter={StaticResource LfBoolToVisibility}}">
                    <TextBlock Text="结果包含警告：请核对安全限制，不代表凭据已被验证或可安全共享。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource LfBrushTextPrimary}" />
                </Border>

                <controls:ResultSummary Margin="{DynamicResource LfBlockSpacing}"
                                        TaskState="{Binding State}"
                                        Conclusion="{Binding Conclusion}"
                                        Note="{Binding ConclusionNote}"
                                        Visibility="{Binding HasResult,
                                                             Converter={StaticResource LfBoolToVisibility}}" />

                <Border Margin="{DynamicResource LfBlockSpacing}"
                        Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}"
                        Visibility="{Binding HasResult,
                                             Converter={StaticResource LfBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="转换结果"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />
                        <TextBlock Text="结果只读；不会写入日志、历史或报告。"
                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                   Foreground="{DynamicResource LfBrushTextMuted}"
                                   Margin="{DynamicResource LfRowSpacing}" />
                        <TextBox Text="{Binding Output, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="{DynamicResource LfDeveloperEditorHeight}"
                                 Margin="{DynamicResource LfInlineSpacing}"
                                 FontFamily="{DynamicResource LfFontFamilyMono}"
                                 FontSize="{DynamicResource LfFontSizeCaption}"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="转换结果" />
                        <WrapPanel>
                            <Button Content="复制结果"
                                    Command="{Binding CopyResultCommand}"
                                    MinWidth="{DynamicResource LfActionButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}" />
                            <TextBlock Text="{Binding ConclusionNote}"
                                       VerticalAlignment="Center"
                                       Margin="{DynamicResource LfInlineSpacingLeading}"
                                       FontSize="{DynamicResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextSecondary}"
                                       TextWrapping="Wrap" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <controls:EmptyState Margin="{DynamicResource LfBlockSpacing}"
                                     Title="选择工具并输入内容"
                                     Description="所有转换均在本机离线完成。JWT 只显示未验证的 Header 和 Payload；凭据不会写入日志、历史或报告。">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState"
                               BasedOn="{StaticResource {x:Type controls:EmptyState}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
