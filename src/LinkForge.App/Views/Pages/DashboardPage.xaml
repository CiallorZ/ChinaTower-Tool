<UserControl x:Class="LinkForge.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LinkForge.App.Controls"
             xmlns:vm="clr-namespace:LinkForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="Transparent">

    <!--
        工作台（UI 规范 §4.1）。

        红线：只显示真实数据。没有真实数据时显示空状态，绝不编造数值。
        因此本页三块内容分别是：
          1. 运行环境：直接读取进程/系统信息，必然为真。
          2. 依赖探测：真实探测结果，缺失就写"未检测到"。
          3. 项目与任务：尚无持久化，明确显示空状态并说明原因。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Padding="{DynamicResource LfContentPadding}">
        <StackPanel>

            <!-- ===== 运行环境 ===== -->
            <TextBlock Text="运行环境"
                       FontSize="{DynamicResource LfFontSizeSectionTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource LfBrushTextPrimary}" />

            <Border Margin="{DynamicResource LfBlockSpacing}"
                    Background="{DynamicResource LfBrushSurface}"
                    BorderBrush="{DynamicResource LfBrushBorder}"
                    BorderThickness="{DynamicResource LfBorderThickness}"
                    CornerRadius="{DynamicResource LfRadiusPanel}"
                    Padding="{DynamicResource LfCardPadding}">
                <ItemsControl ItemsSource="{Binding EnvironmentFacts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{DynamicResource LfInlineSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{DynamicResource LfLabelColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Foreground="{DynamicResource LfBrushTextSecondary}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           TextWrapping="Wrap"
                                           FontFamily="{DynamicResource LfFontFamilyMono}"
                                           Foreground="{DynamicResource LfBrushTextPrimary}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ===== 依赖状态 ===== -->
            <TextBlock Text="依赖状态"
                       Margin="{DynamicResource LfSectionSpacing}"
                       FontSize="{DynamicResource LfFontSizeSectionTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource LfBrushTextPrimary}" />

            <Border Margin="{DynamicResource LfBlockSpacing}"
                    Background="{DynamicResource LfBrushSurface}"
                    BorderBrush="{DynamicResource LfBrushBorder}"
                    BorderThickness="{DynamicResource LfBorderThickness}"
                    CornerRadius="{DynamicResource LfRadiusPanel}"
                    Padding="{DynamicResource LfCardPadding}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Dependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{DynamicResource LfInlineSpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{DynamicResource LfLabelColumnWidth}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 状态用图标 + 文字双重表达，不只用颜色 -->
                                    <TextBlock Grid.Column="0"
                                               FontFamily="{DynamicResource LfIconFontFamily}"
                                               FontSize="{DynamicResource LfIconSizeSm}"
                                               VerticalAlignment="Center"
                                               Margin="{DynamicResource LfLabelSpacing}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xEA39;" />
                                                <Setter Property="Foreground" Value="{DynamicResource LfBrushDanger}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource LfBrushSuccess}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource LfBrushTextPrimary}" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Detail}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource LfBrushTextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="重新检测依赖"
                            Margin="{DynamicResource LfBlockSpacing}"
                            MinWidth="{DynamicResource LfButtonMinWidth}"
                            Height="{DynamicResource LfControlHeight}"
                            HorizontalAlignment="Left"
                            Command="{Binding RefreshDependenciesCommand}"
                            ToolTip="安装依赖后无需重启应用，点击此处重新检测" />
                </StackPanel>
            </Border>

            <!-- ===== 最近项目（空状态） ===== -->
            <TextBlock Text="最近项目"
                       Margin="{DynamicResource LfSectionSpacing}"
                       FontSize="{DynamicResource LfFontSizeSectionTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource LfBrushTextPrimary}" />

            <controls:EmptyState Margin="{DynamicResource LfBlockSpacing}"
                                 Title="尚无项目"
                                 Description="{Binding ProjectsEmptyDescription}" />

            <!-- ===== 最近任务（空状态） ===== -->
            <TextBlock Text="最近任务"
                       Margin="{DynamicResource LfSectionSpacing}"
                       FontSize="{DynamicResource LfFontSizeSectionTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource LfBrushTextPrimary}" />

            <controls:EmptyState Margin="{DynamicResource LfBlockSpacing}"
                                 Title="尚无任务记录"
                                 Description="{Binding RunsEmptyDescription}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>