<UserControl x:Class="LinkForge.App.Views.Pages.ApiWorkbenchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LinkForge.App.Controls"
             xmlns:presentation="clr-namespace:LinkForge.App.Presentation"
             xmlns:vm="clr-namespace:LinkForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ApiWorkbenchViewModel}"
             Background="Transparent">

    <!--
        API 工作台（UI 规范 §5 / UI_WIREFRAMES §5 / LF-007）。

        左侧是真实请求历史，右侧是请求编辑器与响应区。
        不使用假响应；HTTP 4xx/5xx 会作为真实响应展示，传输异常单独归类。
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LfBoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="{DynamicResource LfContentPadding}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：历史与环境变量 -->
            <StackPanel Grid.Column="0">
                <Border Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="请求历史"
                                       FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LfBrushTextPrimary}" />

                            <Button Grid.Column="1"
                                    Content="清空"
                                    Command="{Binding ClearHistoryCommand}"
                                    Height="{DynamicResource LfControlHeightCompact}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}"
                                    ToolTip="清空本地脱敏请求历史" />
                        </Grid>

                        <ListBox ItemsSource="{Binding History}"
                                 Height="{DynamicResource LfHistoryListMaxHeight}"
                                 Margin="{DynamicResource LfBlockSpacing}"
                                 BorderThickness="{DynamicResource LfBorderThicknessNone}"
                                 Background="Transparent"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type presentation:ApiHistoryEntry}">
                                    <StackPanel Margin="{DynamicResource LfInlineSpacing}">
                                        <TextBlock Text="{Binding Summary}"
                                                   FontFamily="{DynamicResource LfFontFamilyMono}"
                                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                                   Foreground="{DynamicResource LfBrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ResultText}"
                                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                                   Foreground="{DynamicResource LfBrushTextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <controls:EmptyState Title="尚无请求历史"
                                             Description="成功或失败的请求都会在此留下脱敏记录；认证字段不会写入历史。">
                            <controls:EmptyState.Style>
                                <Style TargetType="controls:EmptyState"
                                       BasedOn="{StaticResource {x:Type controls:EmptyState}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:EmptyState.Style>
                        </controls:EmptyState>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}"
                        Margin="{DynamicResource LfBlockSpacing}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="环境变量"
                                       FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LfBrushTextPrimary}" />
                            <Button Grid.Column="1"
                                    Content="添加"
                                    Command="{Binding AddEnvironmentVariableCommand}"
                                    Height="{DynamicResource LfControlHeightCompact}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding EnvironmentVariables}"
                                      Margin="{DynamicResource LfBlockSpacing}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type presentation:ApiEnvironmentVariable}">
                                    <Grid Margin="{DynamicResource LfInlineSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="{DynamicResource LfControlHeightCompact}"
                                                 ToolTip="变量名，例如 baseUrl" />

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="{DynamicResource LfControlHeightCompact}"
                                                 ToolTip="变量值；秘密值不会导出" />

                                        <CheckBox Grid.Column="3"
                                                  Content="秘密"
                                                  IsChecked="{Binding IsSecret}"
                                                  Margin="{DynamicResource LfInlineSpacingLeading}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="标记为秘密后仅显示掩码，且不写入历史" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="变量用 {{name}} 引用。秘密值只驻留当前会话，不写入历史与导出。"
                                   FontSize="{DynamicResource LfFontSizeCaption}"
                                   Foreground="{DynamicResource LfBrushTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右侧：请求与响应 -->
            <StackPanel Grid.Column="2">
                <Border Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}">
                    <StackPanel>
                        <TextBlock Text="请求"
                                   FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />

                        <Grid Margin="{DynamicResource LfBlockSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Methods}"
                                      SelectedItem="{Binding SelectedMethod}"
                                      Height="{DynamicResource LfControlHeight}"
                                      IsEnabled="{Binding CanSend}"
                                      MinWidth="{DynamicResource LfMethodColumnWidth}"
                                      AutomationProperties.Name="HTTP 方法" />

                            <controls:LabeledTextBox Grid.Column="2"
                                                     Label="URL"
                                                     IsRequired="True"
                                                     Text="{Binding Url}"
                                                     Placeholder="https://api.example.com/v1/devices"
                                                     Hint="支持 {{baseUrl}} 等环境变量；只允许 http/https。"
                                                     ErrorText="{Binding UrlError}"
                                                     IsEnabled="{Binding CanSend}" />

                            <Button Grid.Column="3"
                                    Content="发送"
                                    Command="{Binding SendCommand}"
                                    MinWidth="{DynamicResource LfActionButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    Margin="{DynamicResource LfInlineSpacingLeading}"
                                    ToolTip="发送当前真实请求" />

                            <Button Grid.Column="4"
                                    Content="取消"
                                    Command="{Binding CancelCommand}"
                                    MinWidth="{DynamicResource LfButtonMinWidth}"
                                    Height="{DynamicResource LfControlHeight}"
                                    Margin="{DynamicResource LfInlineSpacingLeading}"
                                    ToolTip="停止等待响应" />
                        </Grid>

                        <Expander Header="查询参数与请求头"
                                  IsExpanded="True"
                                  Margin="{DynamicResource LfBlockSpacing}">
                            <Grid Margin="{DynamicResource LfBlockSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="查询参数"
                                                   Foreground="{DynamicResource LfBrushTextPrimary}" />
                                        <Button Grid.Column="1"
                                                Content="添加"
                                                Command="{Binding AddQueryParameterCommand}"
                                                Height="{DynamicResource LfControlHeightCompact}"
                                                MinWidth="{DynamicResource LfButtonMinWidth}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding QueryParameters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type presentation:ApiHeaderRow}">
                                                <Grid Margin="{DynamicResource LfInlineSpacing}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="{DynamicResource LfControlHeightCompact}"
                                                             ToolTip="参数名" />
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="{DynamicResource LfControlHeightCompact}"
                                                             ToolTip="参数值" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding QueryError}"
                                               Foreground="{DynamicResource LfBrushDanger}"
                                               FontSize="{DynamicResource LfFontSizeCaption}"
                                               Margin="{DynamicResource LfInlineSpacing}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="请求头"
                                                   Foreground="{DynamicResource LfBrushTextPrimary}" />
                                        <Button Grid.Column="1"
                                                Content="添加"
                                                Command="{Binding AddRequestHeaderCommand}"
                                                Height="{DynamicResource LfControlHeightCompact}"
                                                MinWidth="{DynamicResource LfButtonMinWidth}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding RequestHeaders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type presentation:ApiHeaderRow}">
                                                <Grid Margin="{DynamicResource LfInlineSpacing}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="{DynamicResource LfControlHeightCompact}"
                                                             ToolTip="Header 名称" />
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="{DynamicResource LfControlHeightCompact}"
                                                             ToolTip="Header 值；敏感值会脱敏" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding HeadersError}"
                                               Foreground="{DynamicResource LfBrushDanger}"
                                               FontSize="{DynamicResource LfFontSizeCaption}"
                                               Margin="{DynamicResource LfInlineSpacing}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander Header="认证、Body 与请求选项"
                                  IsExpanded="True"
                                  Margin="{DynamicResource LfBlockSpacing}">
                            <StackPanel Margin="{DynamicResource LfBlockSpacing}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="认证方式"
                                                   Foreground="{DynamicResource LfBrushTextSecondary}"
                                                   FontSize="{DynamicResource LfFontSizeCaption}" />
                                        <ComboBox ItemsSource="{Binding AuthModes}"
                                                  SelectedItem="{Binding SelectedAuthMode}"
                                                  Height="{DynamicResource LfControlHeight}"
                                                  Margin="{DynamicResource LfInlineSpacing}"
                                                  IsEnabled="{Binding CanSend}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="请求体类型"
                                                   Foreground="{DynamicResource LfBrushTextSecondary}"
                                                   FontSize="{DynamicResource LfFontSizeCaption}" />
                                        <ComboBox ItemsSource="{Binding BodyKinds}"
                                                  SelectedItem="{Binding SelectedBodyKind}"
                                                  Height="{DynamicResource LfControlHeight}"
                                                  Margin="{DynamicResource LfInlineSpacing}"
                                                  IsEnabled="{Binding CanHaveBody}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="请求选项"
                                                   Foreground="{DynamicResource LfBrushTextSecondary}"
                                                   FontSize="{DynamicResource LfFontSizeCaption}" />
                                        <CheckBox Content="自动跟随重定向"
                                                  IsChecked="{Binding FollowRedirects}"
                                                  Margin="{DynamicResource LfInlineSpacing}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="{DynamicResource LfInlineSpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <controls:LabeledTextBox Grid.Column="0"
                                                             Label="超时（秒）"
                                                             Text="{Binding TimeoutText}"
                                                             Hint="1–300 秒。"
                                                             ErrorText="{Binding TimeoutError}"
                                                             IsEnabled="{Binding CanSend}" />

                                    <controls:LabeledTextBox Grid.Column="2"
                                                             Label="最大重定向"
                                                             Text="{Binding MaxRedirectsText}"
                                                             Hint="0–10 次。"
                                                             ErrorText="{Binding RedirectError}"
                                                             IsEnabled="{Binding FollowRedirects}" />

                                    <TextBlock Grid.Column="4"
                                               Text="TLS 证书验证始终启用。"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource LfBrushTextSecondary}"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <!-- Basic -->
                                <Grid Margin="{DynamicResource LfInlineSpacingSm}"
                                      Visibility="{Binding IsBasicAuth,
                                                           Converter={StaticResource LfBoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:LabeledTextBox Grid.Column="0"
                                                             Label="用户名"
                                                             Text="{Binding BasicUsername}" />
                                    <controls:SecretTextBox Grid.Column="2"
                                                            Label="密码"
                                                            Secret="{Binding BasicPassword, Mode=TwoWay}"
                                                            ErrorText="{Binding AuthError}" />
                                </Grid>

                                <!-- Bearer -->
                                <Grid Margin="{DynamicResource LfInlineSpacingSm}"
                                      Visibility="{Binding IsBearerAuth,
                                                           Converter={StaticResource LfBoolToVisibility}}">
                                    <controls:SecretTextBox Label="Bearer Token"
                                                            Secret="{Binding BearerToken, Mode=TwoWay}"
                                                            ErrorText="{Binding AuthError}" />
                                </Grid>

                                <!-- API Key -->
                                <Grid Margin="{DynamicResource LfInlineSpacingSm}"
                                      Visibility="{Binding IsApiKeyAuth,
                                                           Converter={StaticResource LfBoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource LfFormColumnGap}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:LabeledTextBox Grid.Column="0"
                                                             Label="API Key Header"
                                                             Text="{Binding ApiKeyHeaderName}" />
                                    <controls:SecretTextBox Grid.Column="2"
                                                            Label="API Key"
                                                            Secret="{Binding ApiKeyValue, Mode=TwoWay}"
                                                            ErrorText="{Binding AuthError}" />
                                </Grid>

                                <Grid Margin="{DynamicResource LfInlineSpacingSm}"
                                      Visibility="{Binding CanHaveBody,
                                                           Converter={StaticResource LfBoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="请求体"
                                               Foreground="{DynamicResource LfBrushTextSecondary}"
                                               FontSize="{DynamicResource LfFontSizeCaption}" />
                                    <TextBox Grid.Row="1"
                                             Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="{DynamicResource LfBodyEditorHeight}"
                                             Margin="{DynamicResource LfInlineSpacing}"
                                             FontFamily="{DynamicResource LfFontFamilyMono}"
                                             FontSize="{DynamicResource LfFontSizeCaption}"
                                             VerticalScrollBarVisibility="Auto" />
                                </Grid>

                                <TextBlock Text="{Binding BodyError}"
                                           Foreground="{DynamicResource LfBrushDanger}"
                                           FontSize="{DynamicResource LfFontSizeCaption}"
                                           Margin="{DynamicResource LfInlineSpacing}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <controls:TaskProgressPanel Margin="{DynamicResource LfBlockSpacing}"
                                            TaskState="{Binding State}"
                                            Stage="{Binding CurrentStage}"
                                            ElapsedText="{Binding ElapsedText}"
                                            CancelCommand="{Binding CancelCommand}"
                                            Visibility="{Binding IsRunning,
                                                                 Converter={StaticResource LfBoolToVisibility}}" />

                <controls:ResultSummary Margin="{DynamicResource LfBlockSpacing}"
                                        TaskState="{Binding State}"
                                        Conclusion="{Binding Conclusion}"
                                        Note="{Binding ConclusionNote}"
                                        Items="{Binding SummaryItems}"
                                        Visibility="{Binding HasResult,
                                                             Converter={StaticResource LfBoolToVisibility}}" />

                <controls:ErrorPanel Margin="{DynamicResource LfBlockSpacing}"
                                     Message="{Binding Conclusion}"
                                     Detail="{Binding FailureDetail}"
                                     IsRecoverable="True"
                                     RetryCommand="{Binding SendCommand}"
                                     Visibility="{Binding FailureDetail,
                                                          Converter={StaticResource LfBoolToVisibility}}" />

                <!-- 响应区 -->
                <Border Margin="{DynamicResource LfBlockSpacing}"
                        Background="{DynamicResource LfBrushSurface}"
                        BorderBrush="{DynamicResource LfBrushBorder}"
                        BorderThickness="{DynamicResource LfBorderThickness}"
                        CornerRadius="{DynamicResource LfRadiusPanel}"
                        Padding="{DynamicResource LfCardPadding}"
                        Visibility="{Binding HasResponse,
                                             Converter={StaticResource LfBoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="响应"
                                       FontSize="{DynamicResource LfFontSizeSectionTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LfBrushTextPrimary}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ResponseStatusText}"
                                       FontFamily="{DynamicResource LfFontFamilyMono}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LfBrushTextPrimary}" />
                        </Grid>

                        <Border Background="{DynamicResource LfBrushWarningSubtle}"
                                BorderBrush="{DynamicResource LfBrushWarning}"
                                BorderThickness="{DynamicResource LfBorderThickness}"
                                CornerRadius="{DynamicResource LfRadiusControl}"
                                Padding="{DynamicResource LfCardPadding}"
                                Margin="{DynamicResource LfInlineSpacing}"
                                Visibility="{Binding IsResponseTruncated,
                                                     Converter={StaticResource LfBoolToVisibility}}">
                            <TextBlock Text="{Binding TruncationNotice}"
                                       Foreground="{DynamicResource LfBrushTextPrimary}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Expander Header="响应头" IsExpanded="True" Margin="{DynamicResource LfInlineSpacing}">
                            <ItemsControl ItemsSource="{Binding ResponseHeaders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type presentation:ApiHeaderRow}">
                                        <Grid Margin="{DynamicResource LfInlineSpacing}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{DynamicResource LfFactLabelColumnWidth}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource LfBrushTextMuted}"
                                                       FontFamily="{DynamicResource LfFontFamilyMono}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayValue}"
                                                       Foreground="{DynamicResource LfBrushTextPrimary}"
                                                       FontFamily="{DynamicResource LfFontFamilyMono}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <TextBlock Text="响应体"
                                   Margin="{DynamicResource LfInlineSpacingSm}"
                                   Foreground="{DynamicResource LfBrushTextSecondary}"
                                   FontSize="{DynamicResource LfFontSizeCaption}" />
                        <TextBox Text="{Binding ResponseBody, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="{DynamicResource LfResponseBodyHeight}"
                                 FontFamily="{DynamicResource LfFontFamilyMono}"
                                 FontSize="{DynamicResource LfFontSizeCaption}"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <WrapPanel Margin="{DynamicResource LfBlockSpacing}"
                           Visibility="{Binding HasResult,
                                                Converter={StaticResource LfBoolToVisibility}}">
                    <Button Content="复制脱敏摘要"
                            Command="{Binding CopySummaryCommand}"
                            MinWidth="{DynamicResource LfActionButtonMinWidth}"
                            Height="{DynamicResource LfControlHeight}" />
                    <Button Content="导出 JSON"
                            Command="{Binding ExportCommand}"
                            MinWidth="{DynamicResource LfButtonMinWidth}"
                            Height="{DynamicResource LfControlHeight}"
                            Margin="{DynamicResource LfInlineSpacingLeading}" />
                    <TextBlock Text="{Binding ActionFeedback}"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource LfInlineSpacingLeading}"
                               FontSize="{DynamicResource LfFontSizeCaption}"
                               Foreground="{DynamicResource LfBrushTextSecondary}"
                               TextWrapping="Wrap" />
                </WrapPanel>

                <Expander Header="请求日志"
                          Margin="{DynamicResource LfBlockSpacing}"
                          Visibility="{Binding HasResult,
                                               Converter={StaticResource LfBoolToVisibility}}">
                    <controls:LogViewer Height="{DynamicResource LfLogPanelDefaultHeight}"
                                        Entries="{Binding Logs}"
                                        Margin="{DynamicResource LfInlineSpacing}" />
                </Expander>

                <controls:EmptyState Margin="{DynamicResource LfBlockSpacing}"
                                     Title="尚未发送 API 请求"
                                     Description="填写 URL 后发送；也可用 {{baseUrl}} 等环境变量。响应状态、头、体、耗时和截断提示都会来自真实请求。">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState"
                               BasedOn="{StaticResource {x:Type controls:EmptyState}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
