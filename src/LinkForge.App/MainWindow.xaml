<Window x:Class="LinkForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LinkForge — 设计令牌验证"
        Width="1100" Height="720"
        MinWidth="{StaticResource LfWindowMinWidth}"
        MinHeight="{StaticResource LfWindowMinHeight}"
        Background="{DynamicResource LfBrushBackground}"
        Foreground="{DynamicResource LfBrushTextPrimary}"
        FontFamily="{StaticResource LfFontFamilyUi}"
        FontSize="{StaticResource LfFontSizeBody}"
        TextOptions.TextFormattingMode="Display">

    <!--
        阶段 01 临时验证面（阶段 03 由 Views/ShellWindow.xaml 取代）。

        存在目的：真实证明设计令牌可解析、可切换、无缺色，
        而不是仅交付一组未被引用的资源字典。
        本窗口所有颜色/间距/字号/圆角均来自 Lf* 令牌，无硬编码视觉值。
    -->
    <Window.Resources>
        <!-- 令牌预览卡的统一外壳；避免四个卡片复制粘贴相同属性集。 -->
        <Style x:Key="TokenSwatchStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LfBrushBorder}" />
            <Setter Property="BorderThickness" Value="{StaticResource LfBorderThickness}" />
            <Setter Property="CornerRadius" Value="{StaticResource LfRadiusPanel}" />
            <Setter Property="Padding" Value="{StaticResource LfCardPadding}" />
            <Setter Property="Margin" Value="{StaticResource LfInlineSpacingLeading}" />
        </Style>

        <!-- 状态语义徽标外壳；颜色由每个实例的 Background/Foreground 覆盖。 -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource LfRadiusPill}" />
            <Setter Property="Padding" Value="{StaticResource LfBadgePadding}" />
            <Setter Property="Margin" Value="{StaticResource LfBadgeSpacing}" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：页面标题区（规范 §3.1 第 3 区的最小形态） -->
        <Border Grid.Row="0"
                Height="{StaticResource LfHeaderHeight}"
                Background="{DynamicResource LfBrushSurface}"
                BorderBrush="{DynamicResource LfBrushDivider}"
                BorderThickness="{StaticResource LfDividerBottom}">
            <Grid Margin="{StaticResource LfHeaderPadding}">
                <TextBlock Text="设计令牌验证"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="主题"
                               VerticalAlignment="Center"
                               Margin="{StaticResource LfLabelSpacing}"
                               Foreground="{DynamicResource LfBrushTextSecondary}" />
                    <Button x:Name="LightThemeButton"
                            Content="浅色"
                            MinWidth="{StaticResource LfButtonMinWidth}"
                            Height="{StaticResource LfControlHeight}"
                            Click="OnLightThemeClick" />
                    <Button x:Name="DarkThemeButton"
                            Content="深色"
                            MinWidth="{StaticResource LfButtonMinWidth}"
                            Height="{StaticResource LfControlHeight}"
                            Margin="{StaticResource LfInlineSpacingLeading}"
                            Click="OnDarkThemeClick" />
                    <Button x:Name="SystemThemeButton"
                            Content="跟随系统"
                            MinWidth="{StaticResource LfButtonMinWidth}"
                            Height="{StaticResource LfControlHeight}"
                            Margin="{StaticResource LfInlineSpacingLeading}"
                            Click="OnSystemThemeClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区：令牌与状态语义预览 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource LfPagePadding}">
            <StackPanel>
                <TextBlock Text="表面层级"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                <Grid Margin="{StaticResource LfBlockSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource TokenSwatchStyle}"
                            Margin="0"
                            Background="{DynamicResource LfBrushBackground}">
                        <StackPanel>
                            <TextBlock Text="Background" Foreground="{DynamicResource LfBrushTextPrimary}" />
                            <TextBlock Text="主工作区底色"
                                       Margin="{StaticResource LfInlineSpacing}"
                                       FontSize="{StaticResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource TokenSwatchStyle}"
                            Background="{DynamicResource LfBrushSurface}">
                        <StackPanel>
                            <TextBlock Text="Surface" Foreground="{DynamicResource LfBrushTextPrimary}" />
                            <TextBlock Text="面板 / 弹层表面"
                                       Margin="{StaticResource LfInlineSpacing}"
                                       FontSize="{StaticResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource TokenSwatchStyle}"
                            Background="{DynamicResource LfBrushSurfaceSubtle}">
                        <StackPanel>
                            <TextBlock Text="SurfaceSubtle" Foreground="{DynamicResource LfBrushTextPrimary}" />
                            <TextBlock Text="次级区域 / 表头"
                                       Margin="{StaticResource LfInlineSpacing}"
                                       FontSize="{StaticResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Style="{StaticResource TokenSwatchStyle}"
                            Background="{DynamicResource LfBrushSurfaceRaised}">
                        <StackPanel>
                            <TextBlock Text="SurfaceRaised" Foreground="{DynamicResource LfBrushTextPrimary}" />
                            <TextBlock Text="悬浮 / 弹层提升面"
                                       Margin="{StaticResource LfInlineSpacing}"
                                       FontSize="{StaticResource LfFontSizeCaption}"
                                       Foreground="{DynamicResource LfBrushTextMuted}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="文本层级"
                           Margin="{StaticResource LfSectionSpacing}"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />
                <StackPanel Margin="{StaticResource LfBlockSpacing}">
                    <TextBlock Text="TextPrimary — 主文本，用于标题与关键数据"
                               Foreground="{DynamicResource LfBrushTextPrimary}" />
                    <TextBlock Text="TextSecondary — 次级文本，用于说明与标签"
                               Margin="{StaticResource LfInlineSpacing}"
                               Foreground="{DynamicResource LfBrushTextSecondary}" />
                    <TextBlock Text="TextMuted — 辅助说明，不得用于关键数据"
                               Margin="{StaticResource LfInlineSpacing}"
                               FontSize="{StaticResource LfFontSizeCaption}"
                               Foreground="{DynamicResource LfBrushTextMuted}" />
                    <TextBlock Text="TextDisabled — 禁用态文本"
                               Margin="{StaticResource LfInlineSpacing}"
                               Foreground="{DynamicResource LfBrushTextDisabled}" />
                </StackPanel>

                <TextBlock Text="状态语义（颜色 + 文字，不得仅靠颜色）"
                           Margin="{StaticResource LfSectionSpacing}"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />
                <WrapPanel Margin="{StaticResource LfBlockSpacing}">
                    <Border Style="{StaticResource StatusBadgeStyle}"
                            Background="{DynamicResource LfBrushSuccessSubtle}">
                        <TextBlock Text="成功 / 通过" Foreground="{DynamicResource LfBrushSuccess}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadgeStyle}"
                            Background="{DynamicResource LfBrushRunningSubtle}">
                        <TextBlock Text="运行中" Foreground="{DynamicResource LfBrushRunning}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadgeStyle}"
                            Background="{DynamicResource LfBrushWarningSubtle}">
                        <TextBlock Text="警告 / 部分成功" Foreground="{DynamicResource LfBrushWarning}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadgeStyle}"
                            Background="{DynamicResource LfBrushDangerSubtle}">
                        <TextBlock Text="失败 / 危险" Foreground="{DynamicResource LfBrushDanger}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadgeStyle}"
                            Background="{DynamicResource LfBrushUnknownSubtle}">
                        <TextBlock Text="未知 / 未检测" Foreground="{DynamicResource LfBrushUnknown}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadgeStyle}"
                            Background="{DynamicResource LfBrushDependencyMissingSubtle}">
                        <TextBlock Text="依赖缺失 / 环境不可用"
                                   Foreground="{DynamicResource LfBrushDependencyMissing}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadgeStyle}"
                            Background="{DynamicResource LfBrushInfoSubtle}">
                        <TextBlock Text="信息提示" Foreground="{DynamicResource LfBrushInfo}" />
                    </Border>
                </WrapPanel>

                <TextBlock Text="强调色与交互边界"
                           Margin="{StaticResource LfSectionSpacing}"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />
                <StackPanel Margin="{StaticResource LfBlockSpacing}" Orientation="Horizontal">
                    <Border Background="{DynamicResource LfBrushAccent}"
                            CornerRadius="{StaticResource LfRadiusControl}"
                            Height="{StaticResource LfControlHeight}"
                            Padding="{StaticResource LfControlPadding}">
                        <TextBlock Text="主操作（Accent）"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource LfBrushTextOnAccent}" />
                    </Border>
                    <Border Background="{DynamicResource LfBrushAccentSubtle}"
                            CornerRadius="{StaticResource LfRadiusControl}"
                            Height="{StaticResource LfControlHeight}"
                            Padding="{StaticResource LfControlPadding}"
                            Margin="{StaticResource LfInlineSpacingLeading}">
                        <TextBlock Text="选中态（AccentSubtle）"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource LfBrushAccent}" />
                    </Border>
                    <Border Background="{DynamicResource LfBrushSurface}"
                            BorderBrush="{DynamicResource LfBrushBorderStrong}"
                            BorderThickness="{StaticResource LfBorderThickness}"
                            CornerRadius="{StaticResource LfRadiusControl}"
                            Height="{StaticResource LfControlHeight}"
                            Padding="{StaticResource LfControlPadding}"
                            Margin="{StaticResource LfInlineSpacingLeading}">
                        <TextBlock Text="输入边界（BorderStrong）"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource LfBrushTextPrimary}" />
                    </Border>
                    <Border Background="{DynamicResource LfBrushSurfaceDisabled}"
                            BorderBrush="{DynamicResource LfBrushBorder}"
                            BorderThickness="{StaticResource LfBorderThickness}"
                            CornerRadius="{StaticResource LfRadiusControl}"
                            Height="{StaticResource LfControlHeight}"
                            Padding="{StaticResource LfControlPadding}"
                            Margin="{StaticResource LfInlineSpacingLeading}">
                        <TextBlock Text="禁用态"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource LfBrushTextDisabled}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部：状态栏 -->
        <Border Grid.Row="2"
                Height="{StaticResource LfStatusBarHeight}"
                Background="{DynamicResource LfBrushSurfaceSubtle}"
                BorderBrush="{DynamicResource LfBrushDivider}"
                BorderThickness="{StaticResource LfDividerTop}">
            <TextBlock x:Name="ThemeStatusText"
                       Margin="{StaticResource LfStatusBarPadding}"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource LfFontSizeCaption}"
                       Foreground="{DynamicResource LfBrushTextSecondary}" />
        </Border>
    </Grid>
</Window>
