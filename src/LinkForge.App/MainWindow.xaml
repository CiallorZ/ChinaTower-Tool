<Window x:Class="LinkForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LinkForge.App.Controls"
        mc:Ignorable="d"
        Title="LinkForge — 基础组件验证"
        Width="1180" Height="860"
        MinWidth="{StaticResource LfWindowMinWidth}"
        MinHeight="{StaticResource LfWindowMinHeight}"
        Background="{DynamicResource LfBrushBackground}"
        Foreground="{DynamicResource LfBrushTextPrimary}"
        FontFamily="{StaticResource LfFontFamilyUi}"
        FontSize="{StaticResource LfFontSizeBody}"
        TextOptions.TextFormattingMode="Display">

    <!--
        阶段 02 基础组件验证面（阶段 03 由 Views/ShellWindow.xaml 取代）。

        存在目的：真实证明基础组件在浅/深色下都可渲染、可交互、状态正确，
        而不是只交付一组未被任何界面使用的样式。

        刻意覆盖组件规范要求的每一类状态：
        空 / 加载 / 运行 / 成功 / 部分成功 / 失败 / 取消 / 依赖缺失。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题区 + 主题切换 -->
        <Border Grid.Row="0"
                Height="{StaticResource LfHeaderHeight}"
                Background="{DynamicResource LfBrushSurface}"
                BorderBrush="{DynamicResource LfBrushDivider}"
                BorderThickness="{StaticResource LfDividerBottom}">
            <Grid Margin="{StaticResource LfHeaderPadding}">
                <TextBlock Text="基础组件验证"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="主题"
                               VerticalAlignment="Center"
                               Margin="{StaticResource LfLabelSpacing}"
                               Foreground="{DynamicResource LfBrushTextSecondary}" />
                    <Button Content="浅色"
                            MinWidth="{StaticResource LfButtonMinWidth}"
                            Height="{StaticResource LfControlHeight}"
                            Click="OnLightThemeClick" />
                    <Button Content="深色"
                            MinWidth="{StaticResource LfButtonMinWidth}"
                            Height="{StaticResource LfControlHeight}"
                            Margin="{StaticResource LfInlineSpacingLeading}"
                            Click="OnDarkThemeClick" />
                    <Button Content="跟随系统"
                            MinWidth="{StaticResource LfButtonMinWidth}"
                            Height="{StaticResource LfControlHeight}"
                            Margin="{StaticResource LfInlineSpacingLeading}"
                            Click="OnSystemThemeClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区：按组件分组展示 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource LfPagePadding}">
            <StackPanel>

                <!-- ===== 状态标签 ===== -->
                <TextBlock Text="状态标签（颜色 + 图标 + 文字三重表达）"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                <WrapPanel Margin="{StaticResource LfBlockSpacing}">
                    <controls:StatusBadge DiagnosticStatus="NotRun"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge DiagnosticStatus="Running"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge DiagnosticStatus="Passed"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge DiagnosticStatus="Failed"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge DiagnosticStatus="Warning"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge DiagnosticStatus="Skipped"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge DiagnosticStatus="Unknown"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge DiagnosticStatus="Cancelled"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge DiagnosticStatus="TimedOut"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                </WrapPanel>

                <WrapPanel Margin="{StaticResource LfInlineSpacing}">
                    <controls:StatusBadge TaskState="Pending"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge TaskState="Preparing"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge TaskState="Running"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge TaskState="Completed"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge TaskState="PartiallySucceeded"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge TaskState="Failed"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge TaskState="Cancelled"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge TaskState="Inconclusive"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                    <controls:StatusBadge DependencyName="Npcap"
                                          Margin="{StaticResource LfBadgeSpacing}" />
                </WrapPanel>

                <!-- ===== 表单控件 ===== -->
                <TextBlock Text="表单输入（可见标签 + 就近错误 + 凭据保护）"
                           Margin="{StaticResource LfSectionSpacing}"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                <Grid Margin="{StaticResource LfBlockSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource LfGridGapLength}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <controls:LabeledTextBox Label="目标地址"
                                                 IsRequired="True"
                                                 Placeholder="10.20.30.40"
                                                 Hint="IPv4 或主机名" />
                        <controls:LabeledTextBox Label="端口"
                                                 Text="554"
                                                 Hint="默认 554"
                                                 Margin="{StaticResource LfBlockSpacing}" />
                        <controls:LabeledTextBox Label="超时（毫秒）"
                                                 Text="-1"
                                                 ErrorText="超时必须为正整数，请改为例如 5000"
                                                 Margin="{StaticResource LfBlockSpacing}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <controls:SecretTextBox Label="设备密码"
                                                Placeholder="留空表示不启用鉴权" />
                        <controls:SecretTextBox Label="API Key"
                                                ErrorText="API Key 长度不足"
                                                Margin="{StaticResource LfBlockSpacing}" />
                    </StackPanel>
                </Grid>

                <!-- ===== 任务进度（运行中） ===== -->
                <TextBlock Text="任务进度（阶段 + 耗时 + 停止入口）"
                           Margin="{StaticResource LfSectionSpacing}"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                <controls:TaskProgressPanel Stage="正在建立 MQTT 连接…"
                                            ElapsedText="00:00:12.4"
                                            TaskState="Running"
                                            Margin="{StaticResource LfBlockSpacing}" />

                <controls:TaskProgressPanel Stage="全部步骤完成"
                                            ElapsedText="00:00:41.2"
                                            TaskState="Completed"
                                            Margin="{StaticResource LfInlineSpacing}" />

                <!-- ===== 结论摘要（部分成功） ===== -->
                <TextBlock Text="结论摘要（结论先于原始日志）"
                           Margin="{StaticResource LfSectionSpacing}"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                <controls:ResultSummary x:Name="SummaryPanel"
                                        Margin="{StaticResource LfBlockSpacing}" />

                <!-- ===== 错误与依赖缺失 ===== -->
                <TextBlock Text="错误与依赖缺失（两者必须可区分）"
                           Margin="{StaticResource LfSectionSpacing}"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                <controls:ErrorPanel Message="无法连接目标：TCP 554 端口无响应"
                                     Detail="System.Net.Sockets.SocketException (10060): A connection attempt failed."
                                     IsRecoverable="True"
                                     Margin="{StaticResource LfBlockSpacing}" />

                <controls:DependencyMissingPanel DependencyName="Npcap"
                                                 Impact="未安装 Npcap，抓包相关步骤无法执行。"
                                                 Guidance="请以管理员身份安装 Npcap，或在设置中关闭抓包步骤后再运行。"
                                                 Margin="{StaticResource LfInlineSpacing}" />

                <!-- ===== 空状态与加载状态 ===== -->
                <TextBlock Text="空状态与加载状态"
                           Margin="{StaticResource LfSectionSpacing}"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                <Grid Margin="{StaticResource LfBlockSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource LfGridGapLength}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:EmptyState Grid.Column="0"
                                         Title="尚未运行诊断"
                                         Description="填入目标地址后点击“开始诊断”，结果将显示在这里。" />

                    <controls:LoadingState Grid.Column="2"
                                           Message="正在解析目标地址…"
                                           Detail="若超过 10 秒未完成，可停止任务后检查 DNS 配置。" />
                </Grid>

                <!-- ===== 日志查看器 ===== -->
                <TextBlock Text="日志查看器（虚拟化 + 级别过滤 + 搜索 + 默认脱敏）"
                           Margin="{StaticResource LfSectionSpacing}"
                           FontSize="{StaticResource LfFontSizeSectionTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LfBrushTextPrimary}" />

                <controls:LogViewer x:Name="LogPanel"
                                    Height="260"
                                    Margin="{StaticResource LfBlockSpacing}" />

            </StackPanel>
        </ScrollViewer>

        <!-- 底部：状态栏 -->
        <Border Grid.Row="2"
                Height="{StaticResource LfStatusBarHeight}"
                Background="{DynamicResource LfBrushSurfaceSubtle}"
                BorderBrush="{DynamicResource LfBrushDivider}"
                BorderThickness="{StaticResource LfDividerTop}">
            <TextBlock x:Name="ThemeStatusText"
                       Margin="{StaticResource LfStatusBarPadding}"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource LfFontSizeCaption}"
                       Foreground="{DynamicResource LfBrushTextSecondary}" />
        </Border>

    </Grid>
</Window>

